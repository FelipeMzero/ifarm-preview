/// Os registros não são editados: corrigir cancela o registro e insere outro, que aponta para ele.
model AnimalTagging {
  id           Int       @id @default(autoincrement())
  notes        String?
  /// Brinco colocado (vazio = brinco retirado).
  tag          String?
  /// Data e hora em que o brinco foi colocado ou retirado.
  identifiedAt DateTime  @map("identified_at") @db.Timestamptz(3)
  /// Quando o registro foi excluído ou corrigido (vazio = válido). Cancelado = ignorado no histórico e nos cálculos.
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(3)

  /// Etapa de brinco da sessão em que o registro foi feito (vazio = registro avulso).
  managementId String?        @map("management_id") @db.Uuid
  management   TagManagement? @relation(fields: [managementId], references: [id], onDelete: Restrict)

  /// Animal que recebeu (ou perdeu) o brinco.
  animalId String @map("animal_id") @db.Uuid
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  /// Registro que este corrige (vazio = lançamento original).
  replacesId Int?           @unique @map("replaces_id")
  replaces   AnimalTagging? @relation("TaggingCorrection", fields: [replacesId], references: [id], onDelete: NoAction)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// Correção deste registro (vazio = não corrigido; se cancelado, foi excluído).
  replacedBy AnimalTagging? @relation("TaggingCorrection")

  @@index([animalId])
  @@index([managementId])
  @@map("animal_tagging")
}

