  items AnimalNeutering[]

  @@index([suggestedTechniqueId])
  @@map("neutering_management")
}

/// Castração de um animal (inclusive recastração): o histórico de castrações dele. Feita avulsa ou
/// numa sessão de manejo (nesse caso, só vale depois que a sessão é consolidada). Ao valer, o
/// animal passa a constar como castrado (Animal.neutered).
/// Os registros não são editados: corrigir cancela o registro e insere outro, que aponta para ele.
model AnimalNeutering {
  id          Int       @id @default(autoincrement())
  notes       String?
  /// Data e hora da castração.
  neuteredAt  DateTime  @map("neutered_at") @db.Timestamptz(3)
  /// Quando o registro foi excluído ou corrigido (vazio = válido). Cancelado = ignorado no histórico e nos cálculos.
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)

  /// Técnica usada neste animal (vazio = não informada).
  techniqueId String?             @map("technique_id") @db.Uuid
  technique   NeuteringTechnique? @relation("NeuteringTechnique", fields: [techniqueId], references: [id], onDelete: Restrict)

  /// Etapa de castração da sessão em que o registro foi feito (vazio = registro avulso).
  managementId String?              @map("management_id") @db.Uuid
  management   NeuteringManagement? @relation(fields: [managementId], references: [id], onDelete: Restrict)

  /// Animal castrado.
  animalId String @map("animal_id") @db.Uuid
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  /// Registro que este corrige (vazio = lançamento original).
  replacesId Int?             @unique @map("replaces_id")
  replaces   AnimalNeutering? @relation("NeuteringCorrection", fields: [replacesId], references: [id], onDelete: NoAction)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// Correção deste registro (vazio = não corrigido; se cancelado, foi excluído).
  replacedBy AnimalNeutering? @relation("NeuteringCorrection")

  @@index([animalId])
  @@index([managementId])
  @@index([techniqueId])
  @@map("animal_neutering")
}

/// Técnica de castração (ex.: "Burdizzo", "Cirúrgica", "Elástico"), usada nas castrações e no
/// planejamento das sessões. Cadastro geral, comum a todas as propriedades.
model NeuteringTechnique {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @unique
  /// Quando a técnica foi desativada (vazio = ativa). Técnica inativa não aparece em registros novos.
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  neuterings  AnimalNeutering[]     @relation("NeuteringTechnique")
  suggestedIn NeuteringManagement[] @relation("NeuteringSuggestedTechnique")

  @@map("neutering_technique")
}

/// Etapa de pesagem de uma sessão de manejo: agrupa as pesagens feitas nos animais da sessão. Uma
/// por sessão.
model WeighingManagement {
  id String @id @default(uuid()) @db.Uuid

  /// Sessão da etapa (no máximo uma etapa de pesagem por sessão).
  managementSessionId String            @unique @map("management_session_id") @db.Uuid
  managementSession   ManagementSession @relation(fields: [managementSessionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  items AnimalWeighing[]

  @@map("weighing_management")
}

/// Pesagem individual de um animal: o histórico de pesos dele. Feita avulsa ou numa sessão de
/// manejo (nesse caso, só vale depois que a sessão é consolidada). O peso atual do animal
/// (Animal.currentWeight) é o da pesagem válida mais recente.
/// Os registros não são editados: corrigir cancela o registro e insere outro, que aponta para ele.
model AnimalWeighing {
  id          Int       @id @default(autoincrement())
  notes       String?
  /// Peso do animal (kg).
  weight      Decimal   @db.Decimal(10, 2)
  /// Data e hora da pesagem.
  weighedAt   DateTime  @map("weighed_at") @db.Timestamptz(3)
  /// Quando o registro foi excluído ou corrigido (vazio = válido). Cancelado = ignorado no histórico, nos gráficos e no peso atual.
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)

  /// Etapa de pesagem da sessão em que o registro foi feito (vazio = registro avulso).
