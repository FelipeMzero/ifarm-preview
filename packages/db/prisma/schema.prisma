// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

generator erd {
  provider      = "prisma-erd-generator"
  output        = "../../../docs/ERD.md" // docs/ na raiz do repositório
  ignorePattern = "User,Session,Account,Verification"
  ignoreEnums   = true
}

/// Propriedade (fazenda): a unidade de gestão do sistema. Cada uma tem as próprias áreas, lotes
/// e animais, e as operações (manejos, compras, transferências) acontecem numa propriedade.
/// Animais podem ser transferidos entre propriedades. Tem sempre um titular, uma localização e um
/// fuso horário, que define a hora e o dia dos eventos dela.
model Property {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  /// Área total, em hectares.
  totalArea      Decimal?  @map("total_area") @db.Decimal(10, 4)
  /// Área produtiva, em hectares; não deve ser maior que a área total.
  productiveArea Decimal?  @map("productive_area") @db.Decimal(10, 4)
  /// Cadastro Ambiental Rural: registro que identifica uma propriedade.
  car            String?   @unique
  /// Cadastro Imobiliário Brasileiro: registro que identifica uma propriedade.
  cib            String?   @unique
  /// Certificado de Cadastro de Imóvel Rural, do INCRA: registro que identifica uma propriedade.
  ccir           String?   @unique
  latitude       Float
  longitude      Float
  /// Fuso horário dos eventos da propriedade usando identificador IANA (ex.: "America/Cuiaba").
  timeZone       String    @default("America/Sao_Paulo") @map("time_zone")
  /// Quando a propriedade foi desativada (vazio = ativa).
  deactivatedAt  DateTime? @map("deactivated_at") @db.Timestamptz(3)

  /// Endereço da propriedade
  addressId Int?     @unique @map("address_id")
  address   Address? @relation(fields: [addressId], references: [id])

  /// Titular da propriedade
  ownerId String @map("owner_id") @db.Uuid
  owner   Person @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  selectedByUserSettings  UserSettings[]
  areas                   Area[]
  batches                 Batch[]
  animals                 Animal[]
  originatedTransfers     AnimalPropertyTransfer[] @relation("AnimalPropertyTransferOrigin")
  receivedTransfers       AnimalPropertyTransfer[] @relation("AnimalPropertyTransferDestination")
  batchTransfers          AnimalBatchTransfer[]
  animalPropertyHistories AnimalPropertyHistory[]
  managementSessions      ManagementSession[]
  purchaseEvents          PurchaseEvent[]
  lossEvents              LossEvent[]
  slaughterEvents         SlaughterEvent[]

  @@index([name])
  @@index([ownerId])
  @@map("property")
}

/// Área de pastagem (piquete) de uma propriedade, com o contorno desenhado no mapa. É ocupada por
/// no máximo um lote por vez, e o pastejo rotacionado acompanha os dias de ocupação e de descanso.
model Area {
  id                    String    @id @default(uuid()) @db.Uuid
  name                  String
  notes                 String?
  /// Contorno desenhado no mapa: lista de vértices [{ lat, lng }].
  polygon               Json
  /// Área em hectares. Pode divergir da área calculada pelo contorno, ex.: medição oficial.
  hectares              Decimal   @db.Decimal(10, 4)
  /// Taxa de lotação suportada, em UA/ha. Capacidade de suporte = hectares × taxa.
  stockingRate          Decimal   @map("stocking_rate") @db.Decimal(10, 4)
  /// Referência de dias que um lote costuma ficar na área (vazio = sem prazo de ocupação).
  defaultOccupationDays Int?      @map("default_occupation_days")
  /// Referência de dias sem animais para o pasto se recuperar (vazio = sem prazo de descanso).
  defaultRestDays       Int?      @map("default_rest_days")
  /// Quando a área foi retirada de uso (vazio = em uso). Área ocupada por um lote não pode ser retirada.
  closedAt              DateTime? @map("closed_at") @db.Timestamptz(3)

  /// Propriedade da área (não muda depois do cadastro).
  propertyId String   @map("property_id") @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  batchAreaHistories BatchAreaHistory[]

  @@index([propertyId])
  @@map("area")
}

/// Lote: grupo de animais manejados juntos em uma propriedade. Enquanto vigente, ocupa uma área de
/// pastagem por vez, que é a localização do lote inteiro, podendo ter uma meta de venda.
model Batch {
  id       String         @id @default(uuid()) @db.Uuid
  name     String
  notes    String?
  /// Meta de venda: data e peso médio a atingir; sem meta = sem registro (RN-LOTE-04).
  saleGoal BatchSaleGoal?
  /// Quando o lote foi encerrado (vazio = vigente). Lote encerrado não ocupa área nem recebe animais.
  closedAt DateTime?      @map("closed_at") @db.Timestamptz(3)

  /// Propriedade do lote (a área que o lote ocupa é sempre desta propriedade).
  propertyId String   @map("property_id") @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  animals                      Animal[]
  batchAreaHistories           BatchAreaHistory[]
  animalBatchHistories         AnimalBatchHistory[]
  destinationAnimalTransfers   AnimalBatchTransfer[]       @relation("AnimalBatchTransferDestination")
  originAnimalTransferItems    AnimalBatchTransferItem[]   @relation("AnimalBatchTransferItemOrigin")
  originLossEventItems         LossEventItem[]             @relation("LossEventItemOrigin")
  originSlaughterEventItems    SlaughterEventItem[]        @relation("SlaughterEventItemOrigin")
  originPropertyTransfers      AnimalPropertyTransfer[]    @relation("AnimalPropertyTransferOriginBatch")
  destinationPropertyTransfers AnimalPropertyTransfer[]    @relation("AnimalPropertyTransferDestinationBatch")
  purchaseReceptions           PurchaseReception[]
  managementSuggestions        BatchManagementSuggestion[]

  @@index([propertyId])
  @@map("batch")
}

/// Meta de venda de um lote: a data para venda e o peso médio que os animais devem atingir até ela.
/// Lote sem meta não tem registro aqui.
model BatchSaleGoal {
  id           Int       @id @default(autoincrement())
  /// Data em que se pretende vender o lote.
  targetDate   DateTime? @map("target_date") @db.Date
  /// Peso médio (em kg) que os animais do lote devem atingir para a venda.
  targetWeight Decimal?  @map("target_weight") @db.Decimal(10, 2)

  /// Lote da meta (um lote tem no máximo uma meta).
  batchId String @unique @map("batch_id") @db.Uuid
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("batch_sale_goal")
}

/// Passagem de um lote por uma área de pastagem: quando entrou e quando saiu. A passagem sem saída
/// é a área atual do lote. Na troca de área, a saída da antiga e a entrada na nova têm a mesma data.
model BatchAreaHistory {
  id        Int       @id @default(autoincrement())
  notes     String?
  /// Quando o lote entrou na área.
  enteredAt DateTime  @map("entered_at") @db.Timestamptz(3)
  /// Quando o lote saiu da área (vazio = o lote está nela agora).
  exitedAt  DateTime? @map("exited_at") @db.Timestamptz(3)

  /// Lote da passagem (um lote tem no máximo uma passagem sem saída, a área atual).
  batchId String @map("batch_id") @db.Uuid
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Restrict)

  /// Área ocupada pelo lote.
  areaId String @map("area_id") @db.Uuid
  area   Area   @relation(fields: [areaId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([batchId], where: { exitedAt: null })
  @@index([batchId, enteredAt])
  @@index([areaId], where: { exitedAt: null })
  @@map("batch_area_history")
}

/// Animal (bovino) do rebanho, acompanhado individualmente ao longo da vida: identificação, lote,
/// pesagens, castração e manejos. Pertence sempre a uma propriedade e a um
/// lote dela enquanto está no rebanho. Os campos "current" são cópias do registro mais recente de cada histórico.
model Animal {
  id                 String       @id @default(uuid()) @db.Uuid
  sex                Sex          @default(MALE)
  birthDate          DateTime?    @map("birth_date") @db.Date
  /// Número sequencial que identifica o animal no sistema (não muda).
  code               Int          @unique @default(autoincrement())
  /// Apelido pelo qual o animal é conhecido.
  name               String?
  /// Indica que a data de nascimento foi estimada (ex.: pela idade na compra), aparecendo como aproximada.
  birthDateEstimated Boolean      @default(false) @map("birth_date_estimated")
  /// Como o animal entrou no rebanho (não muda depois do cadastro).
  origin             AnimalOrigin @default(UNDEFINED)
  /// Situação no rebanho; só o animal ativo participa de manejos, trocas de lote e transferências.
  status             AnimalStatus @default(ACTIVE)
  /// Indica se o animal é castrado (por castração registrada ou porque já chegou castrado).
  neutered           Boolean      @default(false)
  /// Brinco atual, copiado do registro mais recente de AnimalTagging (atualizado junto com ele) para o banco garantir brinco único entre os ativos da propriedade e melhorar o desempenho das buscas por brinco.
  currentTag         String?      @map("current_tag")
  /// RFID atual, copiado do registro mais recente de AnimalRfidTagging (atualizado junto com ele) para o banco garantir RFID único entre os ativos da propriedade e melhorar o desempenho das buscas por RFID.
  currentRfid        String?      @map("current_rfid")
  /// Peso atual (em kg), copiado da pesagem válida mais recente de AnimalWeighing (atualizado junto com ela) para melhorar o desempenho das buscas e dos cálculos por peso.
  currentWeight      Decimal?     @map("current_weight") @db.Decimal(10, 2)

  /// Raça do animal
  breedId String? @map("breed_id") @db.Uuid
  breed   Breed?  @relation(fields: [breedId], references: [id], onDelete: Restrict)

  /// Propriedade atual, copiada da passagem sem saída de AnimalPropertyHistory (atualizada junto com ela) para o banco garantir brinco e RFID únicos entre os ativos da propriedade e melhorar o desempenho das buscas por propriedade.
  currentPropertyId String   @map("current_property_id") @db.Uuid
  currentProperty   Property @relation(fields: [currentPropertyId], references: [id], onDelete: Restrict)

  /// Lote atual (vazio = fora do rebanho), copiado da passagem sem saída de AnimalBatchHistory (atualizado junto com ela) para melhorar o desempenho das buscas por lote.
  currentBatchId String? @map("current_batch_id") @db.Uuid
  currentBatch   Batch?  @relation(fields: [currentBatchId], references: [id], onDelete: Restrict)

  /// Marca (ferro) atual, copiada do registro mais recente de AnimalBranding (atualizada junto com ele) para melhorar o desempenho das buscas por marca.
  currentBrandId String? @map("current_brand_id") @db.Uuid
  currentBrand   Brand?  @relation("AnimalCurrentBrand", fields: [currentBrandId], references: [id], onDelete: SetNull)

  // damId       String?  @db.Uuid @map("dam_id") //Matriz (mãe)
  // dam         Animal?  @relation("AnimalDam", fields: [damId], references: [id], onDelete: Restrict)
  // damProgeny  Animal[] @relation("AnimalDam")

  // sireId       String?  @db.Uuid @map("sire_id") //Reprodutor (pai)
  // sire         Animal?  @relation("AnimalSire", fields: [sireId], references: [id], onDelete: Restrict)
  // sireProgeny  Animal[] @relation("AnimalSire")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  animalNeuterings        AnimalNeutering[]
  animalWeighings         AnimalWeighing[]
  animalTaggings          AnimalTagging[]
  animalRfidTaggings      AnimalRfidTagging[]
  animalBrandings         AnimalBranding[]
  healthManagementItems   HealthManagementItem[]
  managementParticipants  ManagementParticipant[]
  propertyTransferItems   AnimalPropertyTransferItem[]
  batchTransferItems      AnimalBatchTransferItem[]
  animalPropertyHistories AnimalPropertyHistory[]
  animalBatchHistories    AnimalBatchHistory[]
  purchasedAnimals        PurchasedAnimal[]
  lossEventItems          LossEventItem[]
  slaughterEventItems     SlaughterEventItem[]

  @@unique([currentPropertyId, currentTag], where: { status: "ACTIVE", currentTag: { not: null } })
  @@unique([currentPropertyId, currentRfid], where: { status: "ACTIVE", currentRfid: { not: null } })
  @@index([status])
  @@index([breedId])
  //@@index([damId])
  //@@index([sireId])
  @@index([currentPropertyId])
  @@index([currentBrandId])
  @@map("animal")
}

/// Preferências de cada usuário do sistema. Hoje guarda só a propriedade atual: a que o seletor do
/// menu mostra ao abrir o sistema, em qualquer aparelho.
model UserSettings {
  /// Usuário das preferências (uma linha por usuário, criada no primeiro acesso).
  userId String @id @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Propriedade atual do usuário (vazio = nenhuma selecionada; o usuário escolhe na tela).
  currentPropertyId String?   @map("current_property_id") @db.Uuid
  currentProperty   Property? @relation(fields: [currentPropertyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([currentPropertyId])
  @@map("user_settings")
}

/// Pessoa física ou jurídica. Uma mesma pessoa pode ter vários papéis no sistema: titular de
/// propriedade, vendedora numa compra, veterinária responsável por um procedimento sanitário etc.
model Person {
  id                String         @id @default(uuid()) @db.Uuid
  phone             String?
  email             String?        @unique
  /// Nome completo (pessoa física) ou razão social (pessoa jurídica).
  name              String
  /// Física ou jurídica (não muda depois do cadastro).
  type              PersonType
  /// CPF (pessoa física) ou CNPJ (pessoa jurídica); identifica a pessoa e não muda depois do cadastro.
  taxId             String         @unique @map("tax_id")
  /// Inscrição estadual (só pessoa jurídica).
  stateRegistration String?        @unique @map("state_registration")
  /// Nome fantasia (só pessoa jurídica).
  tradeName         String?        @map("trade_name")
  /// Registro Geral (só pessoa física).
  rg                String?        @unique
  /// Data de nascimento (só pessoa física).
  birthDate         DateTime?      @map("birth_date") @db.Date
  /// Estado civil (só pessoa física).
  maritalStatus     MaritalStatus? @map("marital_status")
  /// Quando a pessoa foi desativada (vazio = ativa).
  deactivatedAt     DateTime?      @map("deactivated_at") @db.Timestamptz(3)

  /// Endereço da pessoa
  addressId Int?     @unique @map("address_id")
  address   Address? @relation(fields: [addressId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  properties        Property[]
  healthManagements HealthManagement[]
  purchaseEvents    PurchaseEvent[]
  brands            Brand[]

  @@index([type])
  @@index([name])
  @@map("person")
}

/// Endereço de uma pessoa ou de uma propriedade (cada endereço pertence a no máximo uma delas). É
/// opcional para quem o tem; quando existe, CEP, logradouro, município e UF são obrigatórios.
model Address {
  id           Int     @id @default(autoincrement())
  /// CEP (Código de Endereçamento Postal).
  zipCode      String  @map("zip_code")
  /// Logradouro: rua, avenida, rodovia ou estrada de acesso.
  street       String
  /// Número do imóvel ou ponto de referência na via, quando houver.
  number       String?
  /// Informação adicional para localização (ex.: "Km 15", "Próximo à ponte").
  complement   String?
  /// Bairro ou zona rural.
  neighborhood String?
  /// Município.
  city         String
  /// UF: sigla do estado com 2 letras (ex.: "MT").
  state        String
  /// País (sempre Brasil).
  country      String  @default("Brasil")

  person   Person?
  property Property?

  @@map("address")
}

/// Raça de animal (ex.: "Nelore", "Angus"), usada para classificar o rebanho e as categorias das
/// compras. Cadastro geral, comum a todas as propriedades.
model Breed {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @unique
  /// Quando a raça foi desativada (vazio = ativa). Raça inativa não aparece em cadastros novos.
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  animals            Animal[]
  purchaseCategories PurchaseCategory[]

  @@map("breed")
}

/// Marca de ferro (marca a fogo) que identifica a quem o animal pertence. É de um titular, que pode
/// usá-la nos animais de qualquer uma das suas fazendas, e costuma ser registrada num órgão oficial.
model Brand {
  id                 String    @id @default(uuid()) @db.Uuid
  /// Identificação curta da marca (ex.: "Marca principal", "Marca da recria").
  name               String
  /// Desenho da marca (imagem PNG, JPG ou WEBP).
  image              Bytes?    @map("image")
  /// Número atribuído pelo órgão de registro (repetido no mesmo local indica possível duplicidade).
  registrationNumber String?   @map("registration_number")
  /// Órgão em que a marca foi registrada (prefeitura, órgão estadual ou cartório).
  registrationBody   String?   @map("registration_body")
  /// Município do registro, quando o registro é municipal.
  registrationCity   String?   @map("registration_city")
  /// UF do registro: sigla do estado com 2 letras (ex.: "MT").
  registrationState  String?   @map("registration_state")
  /// Data em que a marca foi registrada no órgão.
  registrationDate   DateTime? @map("registration_date") @db.Date
  /// Quando a marca foi desativada (vazio = ativa). Marca inativa não é aplicada em novos animais.
  deactivatedAt      DateTime? @map("deactivated_at") @db.Timestamptz(3)

  /// Titular da marca: pessoa física ou jurídica dona dela.
  ownerId String @map("owner_id") @db.Uuid
  owner   Person @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  brandings   AnimalBranding[]  @relation("AnimalBrandingBrand")
  suggestedIn BrandManagement[] @relation("BrandSuggestedBrand")
  animals     Animal[]          @relation("AnimalCurrentBrand")

  @@index([ownerId])
  @@map("brand")
}

/// Sessão de manejo: o trabalho feito no curral num grupo de animais de uma propriedade, em que cada
/// animal passa pelas mesmas etapas (pesagem, castração, identificação, ferra, sanitário, apartação).
/// É planejada, executada e, ao final, consolidada (os registros passam a valer no histórico dos
/// animais) ou cancelada (os registros não têm efeito).
model ManagementSession {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  notes       String?
  /// Data e hora previstas para o manejo.
  scheduledAt DateTime  @map("scheduled_at") @db.Timestamptz(3)
  /// Data e hora em que o registro da sessão começou (vazio = ainda não iniciado). Cada registro guarda a própria hora.
  performedAt DateTime? @map("performed_at") @db.Timestamptz(3)
  /// Quando a sessão foi consolidada (vazio = não consolidada). A partir daí, os registros passam a valer.
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(3)
  /// Quando a sessão foi cancelada (vazio = não cancelada). Os registros dela não têm efeito.
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)

  /// Propriedade em que a sessão é feita.
  propertyId String   @map("property_id") @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  steps                   ManagementStep[]
  participants            ManagementParticipant[]
  weighingManagement      WeighingManagement?
  neuteringManagement     NeuteringManagement?
  tagManagement           TagManagement?
  rfidManagement          RfidManagement?
  brandManagement         BrandManagement?
  batchManagement         BatchManagement?
  healthManagements       HealthManagement[]
  purchaseReception       PurchaseReception?
  animalBatchTransfers    AnimalBatchTransfer[]
  animalPropertyTransfers AnimalPropertyTransfer[]

  @@index([propertyId, scheduledAt])
  @@index([propertyId], map: "management_session_open_idx", where: { confirmedAt: null, cancelledAt: null })
  @@map("management_session")
}

/// Etapa de uma sessão de manejo, na ordem em que é feita em cada animal. A configuração da etapa
/// fica no registro do tipo (ex.: técnica prevista, lotes sugeridos, dados do procedimento).
model ManagementStep {
  id       Int                @id @default(autoincrement())
  /// Tipo da etapa (pesagem, castração, brinco, RFID, ferra, sanitário ou apartação).
  type     ManagementStepType
  /// Ordem da etapa na sessão (a partir de 0). A apartação, quando existe, é sempre a última.
  position Int

  /// Sessão da etapa.
  managementSessionId String            @map("management_session_id") @db.Uuid
  managementSession   ManagementSession @relation(fields: [managementSessionId], references: [id], onDelete: Cascade)

  /// Procedimento sanitário da etapa (só nas etapas sanitárias, que podem se repetir na sessão).
  healthManagementId String?           @unique @map("health_management_id") @db.Uuid
  healthManagement   HealthManagement? @relation(fields: [healthManagementId], references: [id], onDelete: Restrict)

  @@unique([managementSessionId, position])
  @@unique([managementSessionId, type], map: "management_step_unique_type", where: { type: { not: "HEALTH" } }) // Cada tipo aparece no máximo uma vez na sessão, exceto o sanitário.
  @@map("management_step")
}

/// Animal que participa de uma sessão de manejo (no máximo uma vez por sessão). Os registros de
/// cada etapa feita nele ficam nas tabelas de cada tipo (ligados à sessão).
model ManagementParticipant {
  id            Int       @id @default(autoincrement())
  /// Na apartação, o animal ficou no lote atual: não gera transferência, mas a etapa conta como feita.
  batchKept     Boolean   @default(false) @map("batch_kept")
  /// Quando foi feito o último registro de etapa no animal (vazio = ainda não manejado). Ordena a lista de manejados.
  lastHandledAt DateTime? @map("last_handled_at") @db.Timestamptz(3)

  /// Sessão da participação.
  managementSessionId String            @map("management_session_id") @db.Uuid
  managementSession   ManagementSession @relation(fields: [managementSessionId], references: [id], onDelete: Restrict)

  /// Animal que participa da sessão.
  animalId String @map("animal_id") @db.Uuid
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([managementSessionId, animalId])
  @@index([animalId])
  @@map("management_participant")
}

/// Etapa de brinco de uma sessão de manejo: agrupa os brincos colocados, trocados ou retirados
/// nos animais da sessão. Uma por sessão.
model TagManagement {
  id String @id @default(uuid()) @db.Uuid

  /// Sessão da etapa (no máximo uma etapa de brinco por sessão).
  managementSessionId String            @unique @map("management_session_id") @db.Uuid
  managementSession   ManagementSession @relation(fields: [managementSessionId], references: [id], onDelete: Restrict)

