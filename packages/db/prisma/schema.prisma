  management   WeighingManagement? @relation(fields: [managementId], references: [id], onDelete: Restrict)

  /// Animal pesado.
  animalId String @map("animal_id") @db.Uuid
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  /// Registro que este corrige (vazio = lançamento original).
  replacesId Int?            @unique @map("replaces_id")
  replaces   AnimalWeighing? @relation("WeighingCorrection", fields: [replacesId], references: [id], onDelete: NoAction)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// Correção deste registro (vazio = não corrigido; se cancelado, foi excluído).
  replacedBy AnimalWeighing? @relation("WeighingCorrection")

  @@index([animalId])
  @@index([managementId])
  @@map("animal_weighing")
}

/// Etapa de marcação de uma sessão de manejo: agrupa as marcações feitas nos animais da sessão.
/// Uma por sessão.
model BrandManagement {
  id String @id @default(uuid()) @db.Uuid

  /// Sessão da etapa (no máximo uma etapa de marcação por sessão).
  managementSessionId String            @unique @map("management_session_id") @db.Uuid
  managementSession   ManagementSession @relation(fields: [managementSessionId], references: [id], onDelete: Restrict)

  /// Marca prevista no planejamento (vazio = não informada). Vem pré-selecionada no registro de
  /// cada animal, que pode usar outra.
  suggestedBrandId String? @map("suggested_brand_id") @db.Uuid
  suggestedBrand   Brand?  @relation("BrandSuggestedBrand", fields: [suggestedBrandId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  items AnimalBranding[]

  @@index([suggestedBrandId])
  @@map("brand_management")
}

/// Marcação de um animal com uma marca de ferro: o histórico de marcas dele. Feita avulsa ou numa
/// sessão de manejo (nesse caso, só vale depois que a sessão é consolidada). Um animal pode ter
/// várias marcas (ex.: uma por dono por que passou).
/// Os registros não são editados: corrigir cancela o registro e insere outro, que aponta para ele.
model AnimalBranding {
  id          Int       @id @default(autoincrement())
  notes       String?
  /// Data e hora da marcação.
  brandedAt   DateTime  @map("branded_at") @db.Timestamptz(3)
  /// Quando o registro foi excluído ou corrigido (vazio = válido). Cancelado = ignorado no histórico.
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)

  /// Etapa de marcação da sessão em que o registro foi feito (vazio = registro avulso).
  managementId String?          @map("management_id") @db.Uuid
  management   BrandManagement? @relation(fields: [managementId], references: [id], onDelete: Restrict)

  /// Marca aplicada neste animal.
  brandId String @map("brand_id") @db.Uuid
  brand   Brand  @relation("AnimalBrandingBrand", fields: [brandId], references: [id], onDelete: Restrict)

  /// Animal marcado.
  animalId String @map("animal_id") @db.Uuid
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  /// Registro que este corrige (vazio = lançamento original).
  replacesId Int?            @unique @map("replaces_id")
  replaces   AnimalBranding? @relation("BrandingCorrection", fields: [replacesId], references: [id], onDelete: NoAction)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// Correção deste registro (vazio = não corrigido; se cancelado, foi excluído).
  replacedBy AnimalBranding? @relation("BrandingCorrection")

  @@index([animalId])
  @@index([managementId])
  @@index([brandId])
  @@map("animal_branding")
}

/// Etapa de apartação de uma sessão de manejo: guarda os lotes sugeridos no planejamento. Uma por
/// sessão. A apartação de cada animal vira um item das transferências de lote da sessão
/// (AnimalBatchTransfer), uma por lote de destino.
model BatchManagement {
  id String @id @default(uuid()) @db.Uuid

  /// Sessão da etapa (no máximo uma etapa de apartação por sessão).
  managementSessionId String            @unique @map("management_session_id") @db.Uuid
  managementSession   ManagementSession @relation(fields: [managementSessionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  suggestedBatches BatchManagementSuggestion[]

  @@map("batch_management")
}

/// Lote sugerido no planejamento de uma apartação: aparece como opção rápida no registro de cada
/// animal, que pode ir para outro lote.
model BatchManagementSuggestion {
  /// Ordem em que o lote aparece no registro.
  position Int

  /// Etapa de apartação que sugere o lote.
  managementId String          @map("management_id") @db.Uuid
  management   BatchManagement @relation(fields: [managementId], references: [id], onDelete: Cascade)

  /// Lote sugerido.
  batchId String @map("batch_id") @db.Uuid
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@id([managementId, batchId])
  @@index([batchId])
  @@map("batch_management_suggestion")
}

/// Procedimento sanitário (vacina, vermífugo, tratamento, exame...) aplicado num grupo de animais,
/// com os dados comuns a todos: produto, dose, carência e próxima dose. Feito avulso ou numa sessão
/// de manejo, que pode ter vários (um por etapa sanitária); em sessão, só vale depois que ela é
/// consolidada. Cada animal tratado é um item, com a data e a hora da sua aplicação.
model HealthManagement {
  id                String                   @id @default(uuid()) @db.Uuid
  /// Produto ou descrição do procedimento (ex.: "Febre aftosa", "Ivermectina 1%").
  title             String?
  /// Último dia de carência (vazio = sem carência): até ele, os animais tratados não podem ser abatidos.
  withdrawalEndDate DateTime?                @map("withdrawal_end_date") @db.Date
  /// Dia previsto para a próxima dose ou reforço (vazio = sem próxima dose).
  nextDueDate       DateTime?                @map("next_due_date") @db.Date
  /// Como a dose de cada animal é definida: sem dose, fixa ou proporcional ao peso.
  doseType          HealthManagementDoseType @default(NONE) @map("dose_type")
  /// Dose de referência (ml): na fixa, a de cada animal; na proporcional, a de cada doseWeightKg.
  doseMl            Decimal?                 @map("dose_ml") @db.Decimal(10, 2)
  /// Na dose proporcional, o peso de referência (kg) (ex.: 1 ml a cada 50 kg).
  doseWeightKg      Decimal?                 @map("dose_weight_kg") @db.Decimal(10, 2)

  /// Tipo do procedimento (ex.: "Vacinação", "Vermifugação").
  typeId String               @map("type_id") @db.Uuid
  type   HealthManagementType @relation(fields: [typeId], references: [id], onDelete: Restrict)

  /// Sessão de manejo em que foi feito (vazio = avulso). Uma sessão pode ter vários.
  managementSessionId String?            @map("management_session_id") @db.Uuid
  managementSession   ManagementSession? @relation(fields: [managementSessionId], references: [id], onDelete: Restrict)

  /// Veterinário responsável (vazio = não informado).
  veterinarianId String? @map("veterinarian_id") @db.Uuid
  veterinarian   Person? @relation(fields: [veterinarianId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  items HealthManagementItem[]
  /// Etapa da sessão que aplica este procedimento (vazio = avulso).
  step  ManagementStep?

  @@index([managementSessionId])
  @@index([nextDueDate])
  @@map("health_management")
}

/// Aplicação de um procedimento sanitário num animal: o histórico sanitário dele. Vale junto com o
/// procedimento (avulso, ou de sessão consolidada).
/// Os registros não são editados: corrigir cancela o registro e insere outro, que aponta para ele.
model HealthManagementItem {
  id          Int       @id @default(autoincrement())
  /// Observação sobre a aplicação neste animal (ex.: reação adversa, aplicação incompleta).
  notes       String?
  /// Data/hora da aplicação neste animal.
  appliedAt   DateTime  @map("applied_at") @db.Timestamptz(3)
  /// Dose aplicada neste animal (ml). Vazio quando o procedimento não tem dose.
  doseMl      Decimal?  @map("dose_ml") @db.Decimal(10, 2)
  /// Quando a aplicação foi excluída ou corrigida (vazio = válida). Cancelada = ignorada no histórico e nos cálculos.
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)

  /// Procedimento aplicado.
  managementId String           @map("management_id") @db.Uuid
  management   HealthManagement @relation(fields: [managementId], references: [id], onDelete: Restrict)

  /// Animal tratado.
  animalId String @map("animal_id") @db.Uuid
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  /// Aplicação que esta corrige (vazio = lançamento original).
  replacesId Int?                  @unique @map("replaces_id")
  replaces   HealthManagementItem? @relation("HealthItemCorrection", fields: [replacesId], references: [id], onDelete: NoAction)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// Correção desta aplicação (vazio = não corrigida; se cancelada, foi excluída).
  replacedBy HealthManagementItem? @relation("HealthItemCorrection")

  @@index([animalId])
  @@index([managementId])
  @@map("health_management_item")
}

/// Tipo de procedimento sanitário (ex.: "Vacinação", "Vermifugação", "Tratamento", "Exame"), usado
/// para classificar os procedimentos. Cadastro geral, comum a todas as propriedades.
model HealthManagementType {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @unique
  /// Quando o tipo foi desativado (vazio = ativo). Tipo inativo não aparece em registros novos.
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  managements HealthManagement[]

  @@map("health_management_type")
}

/// Envio de um grupo de animais de uma propriedade para outra, em duas confirmações: a origem
/// confirma o envio e o destino confirma o recebimento, escolhendo o lote de entrada. Situação:
/// pendente, enviada, recebida ou cancelada.
model AnimalPropertyTransfer {
  id            String    @id @default(uuid()) @db.Uuid
  notes         String?
  /// Data e hora do envio.
  transferredAt DateTime  @map("transferred_at") @db.Timestamptz(3)
  /// Número da GTA (Guia de Trânsito Animal) do transporte (vazio = não informado).
  gtaNumber     String?   @map("gta_number")
  /// Quando a origem confirmou o envio (vazio = não enviada).
  confirmedAt   DateTime? @map("confirmed_at") @db.Timestamptz(3)
  /// Quando o destino confirmou o recebimento (vazio = não recebida).
  receivedAt    DateTime? @map("received_at") @db.Timestamptz(3)
  /// Quando a transferência foi cancelada (vazio = não cancelada).
  cancelledAt   DateTime? @map("cancelled_at") @db.Timestamptz(3)

  /// Propriedade de onde os animais saem.
  originPropertyId String   @map("origin_property_id") @db.Uuid
  originProperty   Property @relation("AnimalPropertyTransferOrigin", fields: [originPropertyId], references: [id], onDelete: Restrict)

  /// Propriedade para onde os animais vão.
  destinationPropertyId String   @map("destination_property_id") @db.Uuid
  destinationProperty   Property @relation("AnimalPropertyTransferDestination", fields: [destinationPropertyId], references: [id], onDelete: Restrict)

  /// Lote de onde os animais saem (vazio = estavam sem lote).
  originBatchId String? @map("origin_batch_id") @db.Uuid
  originBatch   Batch?  @relation("AnimalPropertyTransferOriginBatch", fields: [originBatchId], references: [id], onDelete: Restrict)

  /// Lote em que os animais entram no destino, escolhido no recebimento (vazio = ainda não recebida).
  destinationBatchId String? @map("destination_batch_id") @db.Uuid
  destinationBatch   Batch?  @relation("AnimalPropertyTransferDestinationBatch", fields: [destinationBatchId], references: [id], onDelete: Restrict)

  /// Sessão de manejo que gerou a transferência (vazio = transferência avulsa).
  managementSessionId String?            @map("management_session_id") @db.Uuid
  managementSession   ManagementSession? @relation(fields: [managementSessionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  items AnimalPropertyTransferItem[]

  @@index([originPropertyId])
  @@index([destinationPropertyId])
  @@index([originBatchId])
  @@index([destinationBatchId])
  @@map("animal_property_transfer")
}

/// Animal de uma transferência entre propriedades.
model AnimalPropertyTransferItem {
  id    Int     @id @default(autoincrement())
  notes String?

  /// Transferência de que o animal faz parte.
  transferId String                 @map("transfer_id") @db.Uuid
  transfer   AnimalPropertyTransfer @relation(fields: [transferId], references: [id], onDelete: Restrict)

  /// Animal transferido.
  animalId String @map("animal_id") @db.Uuid
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([animalId])
  @@index([transferId])
  @@map("animal_property_transfer_item")
}

/// Período em que um animal esteve numa propriedade: o histórico de propriedades dele. Aberto ao
/// entrar (cadastro, recebimento de compra ou transferência) e fechado ao sair, inclusive do
/// rebanho (venda, perda, abate). No rebanho, o animal tem um só período aberto, o da propriedade
/// atual (Animal.currentPropertyId). Os eventos do animal usam o fuso da propriedade onde ele
/// estava no momento.
model AnimalPropertyHistory {
  id        Int       @id @default(autoincrement())
  notes     String?
  /// Data e hora em que o animal entrou na propriedade.
  enteredAt DateTime  @map("entered_at") @db.Timestamptz(3)
  /// Data e hora em que o animal saiu da propriedade (vazio = ainda está nela).
  exitedAt  DateTime? @map("exited_at") @db.Timestamptz(3)

  /// Animal.
  animalId String @map("animal_id") @db.Uuid
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  /// Propriedade onde o animal esteve no período.
  propertyId String   @map("property_id") @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([animalId], where: { exitedAt: null })
  @@index([animalId, enteredAt])
  @@index([propertyId], where: { exitedAt: null })
  @@map("animal_property_history")
}

/// Movimentação de um grupo de animais para um lote da mesma propriedade. Feita pela página de
/// transferências (planejada e depois confirmada) ou pela apartação de uma sessão de manejo (uma
/// por lote de destino, confirmada na consolidação). Os animais podem vir de lotes diferentes.
/// Situação: pendente, confirmada ou cancelada.
model AnimalBatchTransfer {
  id            String    @id @default(uuid()) @db.Uuid
  notes         String?
  /// Data e hora da transferência. Na apartação de uma sessão, a do primeiro animal apartado.
  transferredAt DateTime  @map("transferred_at") @db.Timestamptz(3)
  /// Quando a transferência foi confirmada (vazio = não confirmada). A partir daí, os animais estão no lote de destino.
  confirmedAt   DateTime? @map("confirmed_at") @db.Timestamptz(3)
  /// Quando a transferência foi cancelada (vazio = não cancelada).
  cancelledAt   DateTime? @map("cancelled_at") @db.Timestamptz(3)

  /// Lote para onde os animais vão.
  destinationBatchId String @map("destination_batch_id") @db.Uuid
  destinationBatch   Batch  @relation("AnimalBatchTransferDestination", fields: [destinationBatchId], references: [id], onDelete: Restrict)

  /// Propriedade dos animais e dos lotes.
  propertyId String   @map("property_id") @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  /// Sessão de manejo cuja apartação gerou a transferência (vazio = feita pela página de transferências). Enquanto a sessão está aberta, só ela altera a transferência.
  managementSessionId String?            @map("management_session_id") @db.Uuid
  managementSession   ManagementSession? @relation(fields: [managementSessionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  items AnimalBatchTransferItem[]

  @@index([destinationBatchId])
  @@index([propertyId])
  @@index([managementSessionId])
  @@index([propertyId], map: "animal_batch_transfer_open_idx", where: { confirmedAt: null, cancelledAt: null }) // Transferências pendentes da propriedade (compromissos dos animais).
  @@map("animal_batch_transfer")
}

/// Animal de uma transferência entre lotes, com a hora em que ele muda de lote.
model AnimalBatchTransferItem {
  id      Int      @id @default(autoincrement())
  notes   String?
  /// Data e hora em que o animal muda de lote
  movedAt DateTime @map("moved_at") @db.Timestamptz(3)

  /// Transferência de que o animal faz parte.
  transferId String              @map("transfer_id") @db.Uuid
  transfer   AnimalBatchTransfer @relation(fields: [transferId], references: [id], onDelete: Restrict)

  /// Animal transferido.
  animalId String @map("animal_id") @db.Uuid
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  /// Lote de onde o animal saiu, gravado na confirmação (vazio = ainda pendente, ou o animal estava sem lote).
  originBatchId String? @map("origin_batch_id") @db.Uuid
  originBatch   Batch?  @relation("AnimalBatchTransferItemOrigin", fields: [originBatchId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([animalId])
  @@index([transferId])
  @@index([originBatchId])
  @@map("animal_batch_transfer_item")
}

/// Período em que um animal esteve num lote (ou sem lote): o histórico de lotes dele. Aberto ao
/// entrar (cadastro, recebimento de compra, transferência confirmada ou troca de lote na edição do
/// animal) e fechado ao sair, inclusive do rebanho (venda, perda, abate). No rebanho, o animal tem
/// um só período aberto, o do lote atual (Animal.currentBatchId).
model AnimalBatchHistory {
  id        Int       @id @default(autoincrement())
  notes     String?
  /// Data e hora em que o animal entrou no lote.
  enteredAt DateTime  @map("entered_at") @db.Timestamptz(3)
  /// Data e hora em que o animal saiu do lote (vazio = ainda está nele).
  exitedAt  DateTime? @map("exited_at") @db.Timestamptz(3)

  /// Animal.
  animalId String @map("animal_id") @db.Uuid
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  /// Lote onde o animal esteve no período (vazio = esteve sem lote).
  batchId String? @map("batch_id") @db.Uuid
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([animalId], where: { exitedAt: null })
  @@index([animalId, enteredAt])
  @@index([batchId], where: { exitedAt: null })
  @@map("animal_batch_history")
}

/// Compra de animais de um vendedor para uma propriedade: o que foi negociado (categorias e
/// preços), o pagamento e a chegada dos animais, em uma ou mais recepções (viagens). Situação: em
/// andamento, consolidada ou cancelada.
model PurchaseEvent {
  id               String    @id @default(uuid()) @db.Uuid
  notes            String?
  /// Título que distingue a compra das outras do mesmo vendedor.
  title            String
  /// Dia da negociação.
  purchaseDate     DateTime  @map("purchase_date") @db.Date
  /// Dia do pagamento (vazio = não paga). Depois do pagamento, o vendedor, as categorias e os
  /// valores não mudam (o pagamento pode ser desfeito para corrigir).
  paymentDate      DateTime? @map("payment_date") @db.Date
  /// Comprovante do pagamento (ex.: PIX, TED).
  paymentReference String?   @map("payment_reference")
  /// Quando a compra foi consolidada (vazio = não consolidada): exige pagamento, animais recebidos
  /// e nenhuma recepção aberta. Os custos são rateados entre os animais, e a compra não muda mais.
  confirmedAt      DateTime? @map("confirmed_at") @db.Timestamptz(3)
  /// Quando a compra foi cancelada (vazio = não cancelada). Só é possível cancelar se não há
  /// pagamento nem animais recebidos.
  cancelledAt      DateTime? @map("cancelled_at") @db.Timestamptz(3)

  /// Vendedor.
  sellerId String @map("seller_id") @db.Uuid
  seller   Person @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  /// Propriedade que recebe os animais.
  destinationPropertyId String   @map("destination_property_id") @db.Uuid
  destinationProperty   Property @relation(fields: [destinationPropertyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  categories       PurchaseCategory[]
  receptions       PurchaseReception[]
  purchasedAnimals PurchasedAnimal[]

  @@index([sellerId])
  @@index([destinationPropertyId])
  @@map("purchase_event")
}

/// Grupo de animais negociado junto numa compra, com a mesma forma de preço (ex.: "30 machos de 12
/// a 18 meses, por arroba"). Cada animal recebido entra numa categoria.
model PurchaseCategory {
  id               Int                 @id @default(autoincrement())
  notes            String?
  sex              Sex
  /// Idade mínima negociada, em meses (vazio = sem mínimo).
  minAgeMonths     Int?                @map("min_age_months")
  /// Idade máxima negociada, em meses (vazio = sem máximo).
  maxAgeMonths     Int?                @map("max_age_months")
  /// Quantidade de animais negociada.
  expectedQuantity Int                 @map("expected_quantity")
  /// Forma de preço: por cabeça, por arroba ou valor fechado.
  pricingType      PurchasePricingType @map("pricing_type")
  /// Preço por cabeça ou por arroba (vazio no valor fechado).
  unitPrice        Decimal?            @map("unit_price") @db.Decimal(12, 2)
  /// Valor fechado da categoria (só no valor fechado).
  totalPrice       Decimal?            @map("total_price") @db.Decimal(12, 2)
  /// Por arroba: peso faturado (kg), o de origem ou embarque, base do pagamento (vazio = ainda não
  /// informado; exigido até o pagamento).
  invoicedWeight   Decimal?            @map("invoiced_weight") @db.Decimal(12, 2)
  /// Por arroba: quebra de peso acordada (%) entre o embarque e a chegada, descontada do peso
  /// faturado.
  shrinkPercent    Decimal?            @map("shrink_percent") @db.Decimal(5, 2)
  /// No valor fechado, como o valor é rateado entre os animais recebidos: em partes iguais ou pelo
  /// peso de entrada.
  costSplit        PurchaseCostSplit   @default(EQUAL) @map("cost_split")

  /// Raça, quando a categoria é de uma raça só (vazio = raças variadas ou não informada).
  breedId String? @map("breed_id") @db.Uuid
  breed   Breed?  @relation(fields: [breedId], references: [id], onDelete: Restrict)

  /// Compra.
  eventId String        @map("event_id") @db.Uuid
  event   PurchaseEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  animals PurchasedAnimal[]

  @@unique([id, eventId])
  @@index([eventId])
  @@map("purchase_category")
}

/// Chegada de uma carga de animais de uma compra (uma por viagem). É uma sessão de manejo: os
/// animais são cadastrados ao serem recebidos nela e recebem os primeiros manejos; a situação da
/// recepção é a da sessão.
model PurchaseReception {
  id            String  @id @default(uuid()) @db.Uuid
  /// Número da GTA (Guia de Trânsito Animal) da carga (vazio = não informado).
  gtaNumber     String? @map("gta_number")
  /// Número da nota fiscal da carga (vazio = não informado).
  invoiceNumber String? @map("invoice_number")

  /// Compra.
  purchaseEventId String        @map("purchase_event_id") @db.Uuid
  purchaseEvent   PurchaseEvent @relation(fields: [purchaseEventId], references: [id], onDelete: Restrict)

  /// Sessão de manejo da recepção.
  managementSessionId String            @unique @map("management_session_id") @db.Uuid
  managementSession   ManagementSession @relation(fields: [managementSessionId], references: [id], onDelete: Restrict)

  /// Lote em que os animais recebidos entram (até uma eventual apartação na própria recepção).
  entryBatchId String @map("entry_batch_id") @db.Uuid
  entryBatch   Batch  @relation(fields: [entryBatchId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  purchasedAnimals PurchasedAnimal[]

  @@unique([id, purchaseEventId]) //// Alvo da chave estrangeira composta de PurchasedAnimal: a recepção é da mesma compra do animal.
  @@index([purchaseEventId])
  @@index([entryBatchId])
  @@map("purchase_reception")
}

/// Animal recebido numa compra: liga o animal à compra, à categoria em que foi negociado e à
/// recepção em que chegou. Criado ao receber o animal. A categoria e a recepção são ligadas junto
/// com a compra (chaves compostas): o banco garante que as duas são da mesma compra.
model PurchasedAnimal {
  id   Int      @id @default(autoincrement())
  /// Custo de aquisição do animal, rateado na consolidação da compra (vazio = ainda não consolidada).
  cost Decimal? @db.Decimal(12, 2)

  /// Compra.
  purchaseEventId String        @map("purchase_event_id") @db.Uuid
  purchaseEvent   PurchaseEvent @relation(fields: [purchaseEventId], references: [id], onDelete: Restrict)

  /// Categoria em que o animal foi negociado.
  categoryId Int              @map("category_id")
  category   PurchaseCategory @relation(fields: [categoryId, purchaseEventId], references: [id, eventId], onDelete: Restrict)

  /// Recepção em que o animal chegou.
  receptionId String            @map("reception_id") @db.Uuid
  reception   PurchaseReception @relation(fields: [receptionId, purchaseEventId], references: [id, purchaseEventId], onDelete: Restrict)

  /// Animal comprado (cada animal vem de uma compra só).
  animalId String @unique @map("animal_id") @db.Uuid
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([purchaseEventId])
  @@index([categoryId])
  @@index([receptionId])
  @@map("purchased_animal")
}

/// Perda do rebanho: os animais de uma propriedade que morreram ou desapareceram numa mesma data
/// (ex.: as mortes por uma descarga elétrica, os que faltaram na contagem do mês). Registrada como
/// pendente e revisável; os animais só saem do rebanho na consolidação. Situação: pendente,
/// consolidada ou cancelada.
model LossEvent {
  id          String    @id @default(uuid()) @db.Uuid
  /// Título que identifica a perda (ex.: "Contagem de março").
  title       String
  /// Circunstâncias ou detalhes da perda.
  notes       String?
  /// Data e hora em que os animais morreram ou foram dados como desaparecidos.
  occurredAt  DateTime  @map("occurred_at") @db.Timestamptz(3)
  /// Quando a perda foi consolidada (vazio = pendente). A partir daí, os animais saem do rebanho.
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(3)
  /// Quando a perda foi cancelada (vazio = não cancelada).
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)

  /// Propriedade em que a perda ocorreu.
  propertyId String   @map("property_id") @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  items LossEventItem[]

  @@index([propertyId])
  @@map("loss_event")
}

/// Animal de uma perda, com o tipo de perda dele.
model LossEventItem {
  id    Int            @id @default(autoincrement())
  /// Detalhes sobre o animal (ex.: a causa provável da morte).
  notes String?
  /// Tipo de perda deste animal: morte ou desaparecimento.
  type  AnimalLossType

  /// Perda de que o animal faz parte.
  eventId String    @map("event_id") @db.Uuid
  event   LossEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  /// Animal perdido.
  animalId String @map("animal_id") @db.Uuid
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  /// Lote de onde o animal saiu, gravado na consolidação (vazio = ainda pendente, ou o animal estava sem lote).
  originBatchId String? @map("origin_batch_id") @db.Uuid
  originBatch   Batch?  @relation("LossEventItemOrigin", fields: [originBatchId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([animalId])
  @@index([eventId])
  @@index([originBatchId])
  @@map("loss_event_item")
}

/// Abate na própria fazenda, para consumo da propriedade (ex.: alimentação da sede e dos
/// funcionários): os animais abatidos numa mesma data. Planejado com antecedência como pendente e
/// revisável; os animais só saem do rebanho na consolidação, depois de abatidos. Situação:
/// pendente, consolidado ou cancelado. O abate em frigorífico não é um abate, e sim uma venda: o
/// animal sai como vendido.
model SlaughterEvent {
  id            String    @id @default(uuid()) @db.Uuid
  /// Título que identifica o abate.
  title         String
  /// Finalidade ou outros detalhes do abate.
  notes         String?
  /// Data e hora previstas para o abate.
  scheduledAt   DateTime  @map("scheduled_at") @db.Timestamptz(3)
  /// Data e hora em que o abate de fato aconteceu, informadas na consolidação (vazio = não
  /// consolidado).
  slaughteredAt DateTime? @map("slaughtered_at") @db.Timestamptz(3)
  /// Quando o abate foi consolidado (vazio = pendente). A partir daí, os animais saem do rebanho
  /// como abatidos.
  confirmedAt   DateTime? @map("confirmed_at") @db.Timestamptz(3)
  /// Quando o abate foi cancelado (vazio = não cancelado).
  cancelledAt   DateTime? @map("cancelled_at") @db.Timestamptz(3)

  /// Propriedade do abate.
  propertyId String   @map("property_id") @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  items SlaughterEventItem[]

  @@index([propertyId])
  @@map("slaughter_event")
}

/// Animal de um abate.
model SlaughterEventItem {
  id    Int     @id @default(autoincrement())
  /// Observação sobre este animal no abate.
  notes String?

  /// Abate de que o animal faz parte.
  eventId String         @map("event_id") @db.Uuid
  event   SlaughterEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  /// Animal abatido.
  animalId String @map("animal_id") @db.Uuid
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  /// Lote de onde o animal saiu, gravado na consolidação (vazio = ainda pendente, ou o animal estava sem lote).
  originBatchId String? @map("origin_batch_id") @db.Uuid
  originBatch   Batch?  @relation("SlaughterEventItemOrigin", fields: [originBatchId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([animalId])
  @@index([eventId])
  @@index([originBatchId])
  @@map("slaughter_event_item")
}

// Enums

/// Como a dose de cada animal é definida num procedimento sanitário.
enum HealthManagementDoseType {
  /// Procedimento sem dose (ex.: exame, banho, curativo).
  NONE
  /// Mesma dose para todos os animais.
  FIXED
  /// Dose proporcional ao peso vivo do animal.
  PER_WEIGHT

  @@map("health_management_dose_type")
}

/// Tipo de etapa de uma sessão de manejo. Cada tipo tem a sua tabela de etapa (ex.:
/// WeighingManagement) e os seus registros por animal.
enum ManagementStepType {
  /// Pesagem.
  WEIGHING
  /// Castração.
  NEUTERING
  /// Colocação, troca ou retirada de brinco.
  TAG
  /// Colocação, troca ou retirada de RFID.
  RFID
  /// Marcação com marca de ferro.
  BRAND
  /// Procedimento sanitário; uma sessão pode ter vários.
  HEALTH
  /// Apartação: decide o lote de cada animal.
  BATCH

  @@map("management_step_type")
}

/// Forma de preço de uma categoria de compra.
enum PurchasePricingType {
  /// Preço por cabeça, multiplicado pelos animais recebidos.
  PER_HEAD
  /// Preço por arroba, sobre o peso faturado menos a quebra (arroba de 30 kg de peso vivo).
  PER_ARROBA
  /// Valor fechado da categoria, rateado entre os animais recebidos.
  LUMP_SUM

  @@map("purchase_pricing_type")
}

/// Como o valor fechado de uma categoria de compra é rateado entre os animais recebidos.
enum PurchaseCostSplit {
  /// Em partes iguais (valor ÷ animais recebidos).
  EQUAL
  /// Proporcional ao peso de entrada de cada animal.
  BY_WEIGHT

  @@map("purchase_cost_split")
}

/// Sexo do animal.
enum Sex {
  /// Macho.
  MALE
  /// Fêmea.
  FEMALE

  @@map("sex")
}

/// Como o animal entrou no rebanho. Não muda depois do cadastro.
enum AnimalOrigin {
  /// Origem não informada.
  UNDEFINED
  /// Nascido na fazenda.
  BIRTH
  /// Comprado.
  PURCHASE
  /// Recebido em doação.
  DONATION
  /// O animal não existe na fazenda: serve só de referência para a genealogia.
  REFERENCE

  @@map("animal_origin")
}

/// Tipo de perda de um animal: morte ou desaparecimento.
enum AnimalLossType {
  /// Morte.
  DEAD
  /// Desaparecimento.
  MISSING

  @@map("animal_loss_type")
}

/// Situação do animal no rebanho. Fora de ACTIVE, o animal saiu do rebanho, e o brinco e o RFID
/// dele podem ser usados por outro animal.
enum AnimalStatus {
  /// No rebanho da propriedade atual.
  ACTIVE
  /// Vendido, inclusive para abate em frigorífico.
  SOLD
  /// Doado.
  DONATED
  /// Morto.
  DEAD
  /// Desaparecido.
  MISSING
  /// Abatido na fazenda, para consumo da propriedade.
  SLAUGHTERED
  /// O animal não existe na fazenda: serve só de referência para a genealogia.
  REFERENCE

  @@map("animal_status")
}

/// Tipo de pessoa: física ou jurídica.
enum PersonType {
  /// Pessoa física.
  INDIVIDUAL
  /// Pessoa jurídica.
  COMPANY

  @@map("person_type")
}

/// Estado civil de uma pessoa física.
enum MaritalStatus {
  /// Solteiro.
  SINGLE
  /// Casado.
  MARRIED
  /// União estável.
  STABLE_UNION
  /// Divorciado.
  DIVORCED
  /// Viúvo.
  WIDOWED

  @@map("marital_status")
}

// Models do Better Auth (autenticação de usuários do sistema)

model User {
  id            String  @id
  name          String
  email         String  @unique
  emailVerified Boolean @default(false) @map("email_verified")
  image         String?

  // Campos do plugin "admin" do better-auth
  role       String?
  banned     Boolean?  @default(false)
  banReason  String?   @map("ban_reason")
  banExpires DateTime? @map("ban_expires") @db.Timestamptz(3)

  sessions Session[]
  accounts Account[]
  settings UserSettings?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("user")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")

  // Campo do plugin "admin" do better-auth (sessão de impersonation)
  impersonatedBy String? @map("impersonated_by")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("session")
}

model Account {
  id           String  @id
  accountId    String  @map("account_id")
  providerId   String  @map("provider_id")
  accessToken  String? @map("access_token")
  refreshToken String? @map("refresh_token")
  idToken      String? @map("id_token")
  scope        String?
  password     String?

  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)

