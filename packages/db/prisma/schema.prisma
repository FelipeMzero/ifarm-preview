  suggestedTechniqueId String?             @map("suggested_technique_id") @db.Uuid
  suggestedTechnique   NeuteringTechnique? @relation("NeuteringSuggestedTechnique", fields: [suggestedTechniqueId], references: [id], onDelete: Restrict)

