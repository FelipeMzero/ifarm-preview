/// Etapa de castração de uma sessão de manejo: agrupa as castrações feitas nos animais da sessão.
/// Uma por sessão.
model NeuteringManagement {
  id String @id @default(uuid()) @db.Uuid

  /// Sessão da etapa (no máximo uma etapa de castração por sessão).
  managementSessionId String            @unique @map("management_session_id") @db.Uuid
  managementSession   ManagementSession @relation(fields: [managementSessionId], references: [id], onDelete: Restrict)

