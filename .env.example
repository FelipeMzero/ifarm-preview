# Usados no docker-compose.yaml
DB_USER="admin"
DB_PASSWORD="admin"
DB_NAME="db_ifarm"
DB_PORT="5432"

# Usado pelo prisma
DATABASE_URL="postgresql://admin:admin@localhost:5432/db_ifarm?schema=public"

# Usado pelo better-auth (gere um valor com: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Usuário administrador criado pelo seed (prisma/seed.ts). Só usado em dev/local.
SEED_ADMIN_EMAIL="admin@ifarm.local"
SEED_ADMIN_PASSWORD="admin1234"
SEED_ADMIN_NAME="admin"
