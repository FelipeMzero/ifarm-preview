{
  "name": "ifarm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter api dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm -r --no-bail lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @ifarm/db exec prisma generate",
    "db:push": "pnpm --filter @ifarm/db exec prisma db push",
    "db:seed": "pnpm --filter @ifarm/db exec prisma db seed",
    "db:studio": "pnpm --filter @ifarm/db exec prisma studio",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
