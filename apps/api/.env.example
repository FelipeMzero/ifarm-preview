# Porta da API. Em desenvolvimento o web repassa /api/* para ela (API_URL no apps/web/.env).
PORT="3001"

# Banco usado pela API e pelo seed (o mesmo de packages/db/.env)
DATABASE_URL="postgresql://admin:admin@localhost:5432/db_ifarm?schema=public"

# Usado pelo better-auth (gere um valor com: openssl rand -base64 32). O mesmo segredo vai no
# apps/web/.env, para o web ler o cookie da sessão.
BETTER_AUTH_SECRET=""
# Endereço público pelo qual o navegador chega à API (o web, que repassa /api/*).
BETTER_AUTH_URL="http://localhost:3000"

# Usuário administrador criado pelo seed (scripts/seed.ts). Só usado em dev/local.
SEED_ADMIN_EMAIL="admin@ifarm.local"
SEED_ADMIN_PASSWORD="admin1234"
SEED_ADMIN_NAME="admin"
