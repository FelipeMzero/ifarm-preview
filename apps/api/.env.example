# Porta da API. Em desenvolvimento o Vite (apps/web) repassa /api/* para ela.
PORT="3001"

# Banco usado pela API e pelo seed (o mesmo de packages/db/.env)
DATABASE_URL="postgresql://admin:admin@localhost:5432/db_ifarm?schema=public"

# Usado pelo better-auth (gere um valor com: openssl rand -base64 32). Só a API o conhece.
BETTER_AUTH_SECRET=""
# Endereço público pelo qual o navegador chega à API (o web, que repassa /api/*).
BETTER_AUTH_URL="http://localhost:3000"
