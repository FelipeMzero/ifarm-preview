// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema


generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

generator erd {
  provider      = "prisma-erd-generator"
  output        = "../docs/ERD.md"
  ignorePattern = "User,Session,Account,Verification"
  ignoreEnums   = true
}



model Property {
  id             String  @id @default(uuid()) @db.Uuid
  name           String
  totalArea      Decimal? @db.Decimal(10, 4) @map("total_area")      // Área Total (ha)
  productiveArea Decimal? @db.Decimal(10, 4) @map("productive_area")  // Área Produtiva (ha)
  car            String? @unique                  // Cadastro Ambiental Rural
  cib            String? @unique                  // Cadastro Imobiliário Brasileiro
  ccir           String? @unique                  // Certificado de Cadastro de Imóvel Rural (INCRA)
  latitude       Float?
  longitude      Float?
  deactivatedAt DateTime? @map("deactivated_at")

  addressId Int?     @unique @map("address_id")
  address   Address? @relation(fields: [addressId], references: [id])

  ownerId String @db.Uuid @map("owner_id") // Titular
  owner   Person @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  selectedByUserSettings  UserSettings[]
  areas                   Area[]
  batches                 Batch[]
  animals                 Animal[]

  originatedTransfers AnimalPropertyTransfer[] @relation("AnimalPropertyTransferOrigin")
  receivedTransfers AnimalPropertyTransfer[] @relation("AnimalPropertyTransferDestination")
  batchTransfers AnimalBatchTransfer[]
  animalPropertyHistories AnimalPropertyHistory[]
  managementSessions ManagementSession[]
  purchaseEvents PurchaseEvent[]


  @@index([name])
  @@index([ownerId])
  @@map("property")
}

model Area {
  id           String   @id @default(uuid()) @db.Uuid
  name         String                                 // Nome, ex: "Piquete 01"
  polygon      Json                                   // Contorno desenhado no mapa
  hectares     Decimal  @db.Decimal(10, 4)             // Área total (ha)
  stockingRate Decimal  @db.Decimal(10, 4) @map("stocking_rate") // Taxa de lotação (UA/ha)
  notes        String?                                // Observação
  closedAt DateTime? @map("closed_at")            // No caso da Área e Fazenda acho que vai se tornar closedAt (fechar uma área não é o mesmo que desativar uma pessoa)

  propertyId String   @db.Uuid @map("property_id")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  batchAreaHistories BatchAreaHistory[]

  @@index([propertyId])
  @@map("area")
}


model Batch {
  id      String      @id @default(uuid()) @db.Uuid
  name    String
  notes   String?
  saleGoal BatchSaleGoal?
  closedAt DateTime? @map("closed_at")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  propertyId String   @db.Uuid @map("property_id") 
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  // Manejos
  animals Animal[]

  // Tramsferências e históricos
  batchAreaHistories           BatchAreaHistory[]
  animalBatchHistories         AnimalBatchHistory[]
  originAnimalTransfers      AnimalBatchTransfer[]    @relation("AnimalBatchTransferOrigin")
  destinationAnimalTransfers AnimalBatchTransfer[]    @relation("AnimalBatchTransferDestination")
  originPropertyTransfers      AnimalPropertyTransfer[] @relation("AnimalPropertyTransferOriginBatch")
  destinationPropertyTransfers AnimalPropertyTransfer[] @relation("AnimalPropertyTransferDestinationBatch")
  purchaseEvents PurchaseEvent[]

  @@index([propertyId])
  @@map("batch")
}

model BatchSaleGoal {
  id             Int       @id @default(autoincrement())
  targetDate     DateTime? @db.Date           @map("target_date")
  targetWeight   Decimal?  @db.Decimal(10, 2) @map("target_weight")
  // targetValue    Decimal?  @db.Decimal(12, 2) @map("target_value")

  batchId String @unique @db.Uuid @map("batch_id")
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("batch_sale_goal")
}

model BatchAreaHistory {
  id        Int     @id @default(autoincrement())
  enteredAt DateTime  @map("entered_at")
  exitedAt  DateTime? @map("exited_at")
  notes     String?

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  batchId   String    @db.Uuid @map("batch_id")
  batch     Batch     @relation(fields: [batchId], references: [id], onDelete: Restrict)

  areaId    String    @db.Uuid @map("area_id")
  area      Area      @relation(fields: [areaId], references: [id], onDelete: Restrict)

  @@index([batchId, enteredAt])
  @@index([areaId], where: { exitedAt: null })
  @@unique([batchId], where: { exitedAt: null })
  @@map("batch_area_history")
}


model Animal {
  id                String @db.Uuid       @id @default(uuid())
  code              Int                   @unique @default(autoincrement())
  name              String?
  birthDate         DateTime? @db.Date    @map("birth_date")
  origin            AnimalOrigin          @default(UNDEFINED)
  sex               Sex                   @default(MALE)
  status            AnimalStatus          @default(ACTIVE)

  createdAt         DateTime @default(now())  @map("created_at")
  updatedAt         DateTime @updatedAt       @map("updated_at")

  breedId String? @db.Uuid @map("breed_id")
  breed   Breed?  @relation(fields: [breedId], references: [id], onDelete: Restrict)

  // damId       String?  @db.Uuid @map("dam_id") //Matriz (mãe)
  // dam         Animal?  @relation("AnimalDam", fields: [damId], references: [id], onDelete: Restrict)
  // damProgeny  Animal[] @relation("AnimalDam")

  // sireId       String?  @db.Uuid @map("sire_id") //Reprodutor (pai)
  // sire         Animal?  @relation("AnimalSire", fields: [sireId], references: [id], onDelete: Restrict)
  // sireProgeny  Animal[] @relation("AnimalSire")


  // desnormalizado/sincronizado para lote
  currentBatchId String? @db.Uuid @map("current_batch_id")
  currentBatch   Batch?  @relation(fields: [currentBatchId], references: [id], onDelete: Restrict)

  // desnormalizado/sincronizado para propriedade
  currentPropertyId String   @db.Uuid @map("current_property_id") // Campo desnormalizado, pois há constraints que dependem dele, os históricos são apenas registros
  currentProperty   Property @relation(fields: [currentPropertyId], references: [id], onDelete: Restrict)

  // desnormalizado/sincronizado
  currentTag        String?      @map("current_tag") // Campo desnormalizado, pois há constraints que dependem dele, os históricos são apenas registros
  currentRfid       String?      @map("current_rfid") // Campo desnormalizado, pois há constraints que dependem dele, os históricos são apenas registros
  currentWeight    Decimal? @db.Decimal(10, 2)   @map("current_weight") // peso atual (kg)
  neutered          Boolean      @default(false)    // Indica se está castrado ou não

  // Manejos
  neuteringManagementItems NeuteringManagementItem[]
  weighingManagementItems WeighingManagementItem[]
  tagManagementItems  TagManagementItem[]
  rfidManagementItems RfidManagementItem[]
  healthManagementItems HealthManagementItem[]
  managementParticipants ManagementParticipant[]

  // Transferências e históricos
  propertyTransferItems AnimalPropertyTransferItem[]
  batchTransferItems AnimalBatchTransferItem[]
  animalPropertyHistories AnimalPropertyHistory[]
  animalBatchHistories AnimalBatchHistory[]
  purchaseEventItems PurchaseEventItem[]


  @@index([status])
  @@index([breedId])
  //@@index([damId])
  //@@index([sireId])
  @@index([currentPropertyId])
  @@unique([currentPropertyId, currentTag], where: { status: "ACTIVE", currentTag: { not: null } })
  @@unique([currentPropertyId, currentRfid], where: { status: "ACTIVE", currentRfid: { not: null } })
  @@map("animal")
}


model UserSettings {
  userId String @id @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  currentPropertyId String?   @db.Uuid @map("current_property_id")
  currentProperty   Property? @relation(fields: [currentPropertyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([currentPropertyId])
  @@map("user_settings")
}

model Person {
  id             String     @id @default(uuid()) @db.Uuid
  type           PersonType
  taxId          String     @unique @map("tax_id") // CPF/CNPJ
  name           String
  stateRegistration String? @unique @map("state_registration") // Inscrição Estadual
  phone          String?
  email          String?    @unique
  deactivatedAt DateTime? @map("deactivated_at")

  // Exclusivo de Pessoa Jurídica
  tradeName String? @map("trade_name") // Nome Fantasia

  // Exclusivos de Pessoa Física
  rg            String?        @unique          // RG (Registro Geral)
  birthDate     DateTime?      @db.Date @map("birth_date") // Data de nascimento
  maritalStatus MaritalStatus? @map("marital_status") // Estado civil

  addressId Int?     @unique @map("address_id")
  address   Address? @relation(fields: [addressId], references: [id])

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  properties Property[]
  healthManagements HealthManagement[]
  purchaseEvents PurchaseEvent[]


  @@index([type])
  @@index([name])
  @@map("person")
}

model Address {
  id          Int     @id @default(autoincrement())
  zipCode     String  @map("zip_code")     // CEP
  street      String                        // Logradouro
  number      String?
  complement  String?                       // Complemento
  neighborhood String?                      // Bairro
  city        String                        // Município
  state       String                        // UF (unidade federativa)
  country     String  @default("Brasil")    // País

  person   Person?
  property Property?

  @@map("address")
}

model Breed {
  id      String   @id @default(uuid()) @db.Uuid
  name    String   @unique
  deactivatedAt DateTime? @map("deactivated_at")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  animals Animal[]
  purchaseEventItems PurchaseEventItem[]

  @@map("breed")
}







model ManagementSession {
  id             String    @id @default(uuid()) @db.Uuid
  notes          String?
  scheduledDate  DateTime  @map("scheduled_date")  // data prevista, usada para lembretes/agendamento
  managementDate DateTime? @map("management_date") // data em que o manejo de fato ocorreu
  confirmedAt    DateTime? @map("confirmed_at")
  cancelledAt    DateTime? @map("cancelled_at")

  propertyId String   @db.Uuid @map("property_id")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  participants ManagementParticipant[]

  weighingManagement        WeighingManagement?
  neuteringManagement       NeuteringManagement?
  tagManagement  TagManagement?
  rfidManagement RfidManagement?
  healthManagements         HealthManagement[]

  animalBatchTransfers    AnimalBatchTransfer[]
  animalPropertyTransfers AnimalPropertyTransfer[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([propertyId, scheduledDate])
  @@map("management_session")
}

model ManagementParticipant {
  id Int @id @default(autoincrement())

  managementSessionId String            @db.Uuid @map("management_session_id")
  managementSession    ManagementSession @relation(fields: [managementSessionId], references: [id], onDelete: Restrict)

  animalId String @db.Uuid @map("animal_id")
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  // batchId String? @db.Uuid @map("batch_id") // Colocar isso se for frequente precisar de "todas as pesagens realizadas enquanto o animal estava no Lote X"

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([managementSessionId, animalId])
  @@index([animalId])
  @@map("management_participant")
}

model TagManagement {
  id    String  @id @default(uuid()) @db.Uuid
  items TagManagementItem[]

  managementSessionId String            @unique @db.Uuid @map("management_session_id")
  managementSession   ManagementSession @relation(fields: [managementSessionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("tag_management")
}

model TagManagementItem {
  id    Int     @id @default(autoincrement())
  tag   String? // null = tag removida
  notes String?

  identifiedAt DateTime? @map("identified_at") // preenchido só quando managementId = null (avulso)

  managementId String?         @db.Uuid @map("management_id") // null = avulso
  management   TagManagement?  @relation(fields: [managementId], references: [id], onDelete: Restrict)

  animalId String @db.Uuid @map("animal_id")
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([animalId])
  @@index([managementId])
  @@map("tag_management_item")
}


model RfidManagement {
  id    String  @id @default(uuid()) @db.Uuid
  items RfidManagementItem[]

  managementSessionId String            @unique @db.Uuid @map("management_session_id")
  managementSession   ManagementSession @relation(fields: [managementSessionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("rfid_management")
}

model RfidManagementItem {
  id    Int     @id @default(autoincrement())
  rfid  String? // null = rfid removido
  notes String?

  identifiedAt DateTime? @map("identified_at") // preenchido só quando managementId = null (avulso)

  managementId String?          @db.Uuid @map("management_id") // null = avulso
  management   RfidManagement?  @relation(fields: [managementId], references: [id], onDelete: Restrict)

  animalId String @db.Uuid @map("animal_id")
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([animalId])
  @@index([managementId])
  @@map("rfid_management_item")
}

model NeuteringManagement {
  id    String  @id @default(uuid()) @db.Uuid
  items NeuteringManagementItem[]

  managementSessionId String            @unique @db.Uuid @map("management_session_id")
  managementSession   ManagementSession @relation(fields: [managementSessionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("neutering_management")
}

model NeuteringManagementItem {
  id     Int     @id @default(autoincrement())
  method String? // método usado neste animal (ex.: burdizzo, cirúrgica, elástico)
  notes  String? // observação específica desse animal (ex.: complicação, sangramento, recastração)

  neuteredAt DateTime? @map("neutered_at") // preenchido só quando managementId = null (avulso)

  managementId String?              @db.Uuid @map("management_id") // null = avulso
  management   NeuteringManagement? @relation(fields: [managementId], references: [id], onDelete: Restrict)

  animalId String @db.Uuid @map("animal_id")
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([animalId])
  @@index([managementId])
  @@map("neutering_management_item")
}

model WeighingManagement {
  id    String  @id @default(uuid()) @db.Uuid
  items WeighingManagementItem[]

  managementSessionId String            @unique @db.Uuid @map("management_session_id")
  managementSession   ManagementSession @relation(fields: [managementSessionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("weighing_management")
}

model WeighingManagementItem {
  id     Int     @id @default(autoincrement())
  weight Decimal @db.Decimal(10, 2) // valor da pesagem (kg), sempre individual
  notes  String?
  weighedAt DateTime? @map("weighed_at") // preenchido só quando managementId = null (avulso)

  // Correções preservam o rastro: o peso lançado originalmente é guardado na primeira correção
  // e a exclusão é lógica (cancelada = ignorada no histórico, gráficos e peso atual).
  originalWeight Decimal?  @db.Decimal(10, 2) @map("original_weight")
  correctedAt    DateTime? @map("corrected_at")
  cancelledAt    DateTime? @map("cancelled_at")

  managementId String?             @db.Uuid @map("management_id") // null = avulso
  management   WeighingManagement? @relation(fields: [managementId], references: [id], onDelete: Restrict)

  animalId String @db.Uuid @map("animal_id")
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([animalId])
  @@index([managementId])
  @@map("weighing_management_item")
}


model HealthManagement {
  id                String                       @id @default(uuid()) @db.Uuid
  title             String?
  withdrawalUntil   DateTime?                    @db.Date @map("withdrawal_until")
  nextDueDate       DateTime?                    @db.Date @map("next_due_date")
  pricingType       HealthManagementPricingType?  @map("pricing_type")
  unitPrice         Decimal?                     @db.Decimal(10, 2) @map("unit_price")

  performedAt DateTime? @map("performed_at") // preenchido só quando managementSessionId = null (avulso)

  items HealthManagementItem[]

  typeId String                @db.Uuid @map("type_id")
  type   HealthManagementType  @relation(fields: [typeId], references: [id], onDelete: Restrict)

  managementSessionId String?            @db.Uuid @map("management_session_id") // null = avulso; sem @unique — múltiplos procedimentos sanitários podem existir na mesma sessão
  managementSession   ManagementSession? @relation(fields: [managementSessionId], references: [id], onDelete: Restrict)

  veterinarianId String? @db.Uuid @map("veterinarian_id")
  veterinarian   Person? @relation(fields: [veterinarianId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([managementSessionId])
  @@index([nextDueDate])
  @@map("health_management")
}

model HealthManagementItem {
  id    Int      @id @default(autoincrement())
  notes String?  // observação específica desse animal nesse procedimento (reação adversa, etc.)
  cost  Decimal? @db.Decimal(10, 2) // Custo individual

  managementId String           @db.Uuid @map("management_id")
  management   HealthManagement @relation(fields: [managementId], references: [id], onDelete: Restrict)

  animalId String @db.Uuid @map("animal_id")
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([animalId])
  @@index([managementId])
  @@map("health_management_item")
}

model HealthManagementType {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @unique
  deactivatedAt DateTime? @map("deactivated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  managements HealthManagement[]

  @@map("health_management_type")
}


enum HealthManagementPricingType {
  FREE        // gratuito de fato (campanha subsidiada, produto doado)
  FIXED       // valor fixo por animal, independente de peso
  PER_WEIGHT  // valor por kg de peso vivo
  @@map("health_management_pricing_type")
}










model AnimalPropertyTransfer {
  id             String    @id @default(uuid()) @db.Uuid
  transferDate   DateTime  @map("transfer_date")
  notes          String?
  gtaNumber      String?   @map("gta_number")

  confirmedAt    DateTime? @map("confirmed_at") // origem confirma o envio
  receivedAt  DateTime? @map("received_at")  // destino confirma o recebimento
  cancelledAt    DateTime? @map("cancelled_at")

  items AnimalPropertyTransferItem[]

  originPropertyId String   @db.Uuid @map("origin_property_id")
  originProperty   Property @relation("AnimalPropertyTransferOrigin", fields: [originPropertyId], references: [id], onDelete: Restrict)

  destinationPropertyId String   @db.Uuid @map("destination_property_id")
  destinationProperty   Property @relation("AnimalPropertyTransferDestination", fields: [destinationPropertyId], references: [id], onDelete: Restrict)

  originBatchId String? @db.Uuid @map("origin_batch_id") // null = animais vinham sem lote
  originBatch   Batch?  @relation("AnimalPropertyTransferOriginBatch", fields: [originBatchId], references: [id], onDelete: Restrict)

  destinationBatchId String? @db.Uuid @map("destination_batch_id") // preenchido só no recebimento, pelo destino
  destinationBatch   Batch?  @relation("AnimalPropertyTransferDestinationBatch", fields: [destinationBatchId], references: [id], onDelete: Restrict)

  managementSessionId String?            @db.Uuid @map("management_session_id") // null = transferência isolada
  managementSession   ManagementSession? @relation(fields: [managementSessionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([originPropertyId])
  @@index([destinationPropertyId])
  @@index([originBatchId])
  @@index([destinationBatchId])
  @@map("animal_property_transfer")
}

model AnimalPropertyTransferItem {
  id    Int     @id @default(autoincrement())
  notes String?

  transferId String                @db.Uuid @map("transfer_id")
  transfer   AnimalPropertyTransfer @relation(fields: [transferId], references: [id], onDelete: Restrict)

  animalId String @db.Uuid @map("animal_id")
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([animalId])
  @@index([transferId])
  @@map("animal_property_transfer_item")
}

model AnimalPropertyHistory {
  id        Int       @id @default(autoincrement())
  enteredAt DateTime  @map("entered_at")
  exitedAt  DateTime? @map("exited_at")
  notes     String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  animalId String @db.Uuid @map("animal_id")
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  propertyId String   @db.Uuid @map("property_id")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  @@index([animalId, enteredAt])
  @@index([propertyId], where: { exitedAt: null })
  @@unique([animalId], where: { exitedAt: null })
  @@map("animal_property_history")
}

model AnimalBatchTransfer {
  id           String    @id @default(uuid()) @db.Uuid
  transferDate DateTime  @map("transfer_date")
  notes        String?
  confirmedAt  DateTime? @map("confirmed_at")
  cancelledAt  DateTime? @map("cancelled_at")

  items AnimalBatchTransferItem[]

  originBatchId String? @db.Uuid @map("origin_batch_id") // null = animal não estava em lote nenhum
  originBatch   Batch?  @relation("AnimalBatchTransferOrigin", fields: [originBatchId], references: [id], onDelete: Restrict)

  destinationBatchId String @db.Uuid @map("destination_batch_id")
  destinationBatch   Batch  @relation("AnimalBatchTransferDestination", fields: [destinationBatchId], references: [id], onDelete: Restrict)

  propertyId String   @db.Uuid @map("property_id")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  managementSessionId String?            @db.Uuid @map("management_session_id") // null = transferência isolada
  managementSession   ManagementSession? @relation(fields: [managementSessionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([originBatchId])
  @@index([destinationBatchId])
  @@index([propertyId])
  @@index([managementSessionId])
  @@map("animal_batch_transfer")
}

model AnimalBatchTransferItem {
  id    Int     @id @default(autoincrement())
  notes String?

  transferId String             @db.Uuid @map("transfer_id")
  transfer   AnimalBatchTransfer @relation(fields: [transferId], references: [id], onDelete: Restrict)

  animalId String @db.Uuid @map("animal_id")
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([animalId])
  @@index([transferId])
  @@map("animal_batch_transfer_item")
}

model AnimalBatchHistory {
  id        Int      @id @default(autoincrement())
  enteredAt DateTime @map("entered_at")
  exitedAt  DateTime? @map("exited_at")
  notes     String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  animalId String @db.Uuid @map("animal_id")
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  batchId String? @db.Uuid @map("batch_id") // null = animal sem lote nesse período
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([animalId, enteredAt])
  @@index([batchId], where: { exitedAt: null })
  @@unique([animalId], where: { exitedAt: null })
  @@map("animal_batch_history")
}


model PurchaseEvent {
  id           String    @id @default(uuid()) @db.Uuid
  purchaseDate DateTime  @map("purchase_date")
  gtaNumber    String?   @map("gta_number")
  notes        String?
  confirmedAt  DateTime? @map("confirmed_at")
  cancelledAt  DateTime? @map("cancelled_at")

  pricingType    PurchasePricingType @map("pricing_type")
  pricePerArroba Decimal?            @db.Decimal(10, 2) @map("price_per_arroba") // usado se pricingType = PER_ARROBA
  totalPrice     Decimal?            @db.Decimal(12, 2) @map("total_price")      // usado se pricingType = LUMP_SUM

  items PurchaseEventItem[]

  sellerId String @db.Uuid @map("seller_id")
  seller   Person @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  destinationPropertyId String   @db.Uuid @map("destination_property_id")
  destinationProperty   Property @relation(fields: [destinationPropertyId], references: [id], onDelete: Restrict)

  destinationBatchId String? @db.Uuid @map("destination_batch_id")
  destinationBatch   Batch?  @relation(fields: [destinationBatchId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sellerId])
  @@index([destinationPropertyId])
  @@index([destinationBatchId])
  @@map("purchase_event")
}

model PurchaseEventItem {
  id        Int      @id @default(autoincrement())
  weight    Decimal? @db.Decimal(10, 2) // peso de entrada — base do cálculo por arroba, quando aplicável
  cost      Decimal? @db.Decimal(10, 2) // custo individual calculado e congelado na confirmação
  tag       String?
  rfid      String?
  sex       Sex?
  birthDate DateTime? @db.Date    @map("birth_date")
  notes     String?

  breedId String? @db.Uuid @map("breed_id")
  breed   Breed?  @relation(fields: [breedId], references: [id], onDelete: Restrict)

  eventId String        @db.Uuid @map("event_id")
  event   PurchaseEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  animalId String? @unique @db.Uuid @map("animal_id") // null até a confirmação; preenchido ao materializar o Animal
  animal   Animal? @relation(fields: [animalId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([eventId])
  @@map("purchase_event_item")
}

// Enums

enum PurchasePricingType {
  PER_ARROBA
  LUMP_SUM
  @@map("purchase_pricing_type")
}


enum Sex {
  MALE   // Macho
  FEMALE // Fêmea
  @@map("sex")
}

enum AnimalOrigin {
  UNDEFINED // Indefinida
  BIRTH     // Nascimento
  PURCHASE  // Compra
  DONATION  // Doação
  REFERENCE // Referência (o animal não existe na fazenda, serve apenas de referência para genealogia)
  @@map("animal_origin")
}

enum AnimalStatus {
  ACTIVE      // Ativo na propriedade
  SOLD        // Vendido
  DONATED     // Doado
  DEAD        // Morto
  DISCARDED   // Descarte
  SLAUGHTERED // Abate
  REFERENCE   // Referência (o animal não existe na fazenda, serve apenas de referência para genealogia)
  @@map("animal_status")
}

enum PersonType {
  INDIVIDUAL // Pessoa Física
  COMPANY    // Pessoa Jurídica

  @@map("person_type")
}

enum MaritalStatus {
  SINGLE       // Solteiro
  MARRIED      // Casado
  STABLE_UNION // União Estável
  DIVORCED     // Divorciado
  WIDOWED      // Viúvo

  @@map("marital_status")
}















// Models do Better Auth (autenticação de usuários do sistema)

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?

  // Campos do plugin "admin" do better-auth
  role       String?
  banned     Boolean?  @default(false)
  banReason  String?   @map("ban_reason")
  banExpires DateTime? @map("ban_expires")

  sessions Session[]
  accounts Account[]
  settings UserSettings?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")

  // Campo do plugin "admin" do better-auth (sessão de impersonation)
  impersonatedBy String? @map("impersonated_by")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("session")
}

model Account {
  id           String  @id
  accountId    String  @map("account_id")
  providerId   String  @map("provider_id")
  accessToken  String? @map("access_token")
  refreshToken String? @map("refresh_token")
  idToken      String? @map("id_token")
  scope        String?
  password     String?

  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("verification")
}