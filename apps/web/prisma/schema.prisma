// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

generator erd {
  provider      = "prisma-erd-generator"
  output        = "../../../docs/ERD.md" // docs/ na raiz do repositório
  ignorePattern = "User,Session,Account,Verification"
  ignoreEnums   = true
}

model Property {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  totalArea       Decimal?  @map("total_area") @db.Decimal(10, 4) // Área Total (ha)
  productiveArea  Decimal?  @map("productive_area") @db.Decimal(10, 4) // Área Produtiva (ha)
  car             String?   @unique // Cadastro Ambiental Rural
  cib             String?   @unique // Cadastro Imobiliário Brasileiro
  ccir            String?   @unique // Certificado de Cadastro de Imóvel Rural (INCRA)
  latitude        Float?
  longitude       Float?
  registeredBrand String?   @map("registered_brand") // desenho/código da marca de ferro registrada
  deactivatedAt   DateTime? @map("deactivated_at")

  addressId Int?     @unique @map("address_id")
  address   Address? @relation(fields: [addressId], references: [id])

  ownerId String @map("owner_id") @db.Uuid // Titular
  owner   Person @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  selectedByUserSettings UserSettings[]
  areas                  Area[]
  batches                Batch[]
  animals                Animal[]

  originatedTransfers     AnimalPropertyTransfer[] @relation("AnimalPropertyTransferOrigin")
  receivedTransfers       AnimalPropertyTransfer[] @relation("AnimalPropertyTransferDestination")
  batchTransfers          AnimalBatchTransfer[]
  animalPropertyHistories AnimalPropertyHistory[]
  managementSessions      ManagementSession[]
  purchaseEvents          PurchaseEvent[]

  @@index([name])
  @@index([ownerId])
  @@map("property")
}

model Area {
  id                    String    @id @default(uuid()) @db.Uuid
  name                  String // Nome, ex: "Piquete 01"
  polygon               Json // Contorno desenhado no mapa
  hectares              Decimal   @db.Decimal(10, 4) // Área total (ha)
  stockingRate          Decimal   @map("stocking_rate") @db.Decimal(10, 4) // Taxa de lotação (UA/ha)
  defaultOccupationDays Int?      @map("default_occupation_days") // referência geral, usada quando não há plano ativo
  defaultRestDays       Int?      @map("default_rest_days") // idem
  notes                 String? // Observação
  closedAt              DateTime? @map("closed_at") // No caso da Área e Fazenda acho que vai se tornar closedAt (fechar uma área não é o mesmo que desativar uma pessoa)

  propertyId String   @map("property_id") @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  batchAreaHistories BatchAreaHistory[]

  @@index([propertyId])
  @@map("area")
}

model Batch {
  id       String         @id @default(uuid()) @db.Uuid
  name     String
  notes    String?
  saleGoal BatchSaleGoal?
  closedAt DateTime?      @map("closed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  propertyId String   @map("property_id") @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  // Manejos
  animals Animal[]

  // Tramsferências e históricos
  batchAreaHistories           BatchAreaHistory[]
  animalBatchHistories         AnimalBatchHistory[]
  destinationAnimalTransfers   AnimalBatchTransfer[]       @relation("AnimalBatchTransferDestination")
  originAnimalTransferItems    AnimalBatchTransferItem[]   @relation("AnimalBatchTransferItemOrigin")
  originPropertyTransfers      AnimalPropertyTransfer[]    @relation("AnimalPropertyTransferOriginBatch")
  destinationPropertyTransfers AnimalPropertyTransfer[]    @relation("AnimalPropertyTransferDestinationBatch")
  purchaseReceptions           PurchaseReception[]
  managementSuggestions        BatchManagementSuggestion[]

  @@index([propertyId])
  @@map("batch")
}

model BatchSaleGoal {
  id           Int       @id @default(autoincrement())
  targetDate   DateTime? @map("target_date") @db.Date
  targetWeight Decimal?  @map("target_weight") @db.Decimal(10, 2)
  // targetValue    Decimal?  @db.Decimal(12, 2) @map("target_value")

  batchId String @unique @map("batch_id") @db.Uuid
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("batch_sale_goal")
}

model BatchAreaHistory {
  id        Int       @id @default(autoincrement())
  enteredAt DateTime  @map("entered_at")
  exitedAt  DateTime? @map("exited_at")
  notes     String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  batchId String @map("batch_id") @db.Uuid
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Restrict)

  areaId String @map("area_id") @db.Uuid
  area   Area   @relation(fields: [areaId], references: [id], onDelete: Restrict)

  @@unique([batchId], where: { exitedAt: null })
  @@index([batchId, enteredAt])
  @@index([areaId], where: { exitedAt: null })
  @@map("batch_area_history")
}

model Animal {
  id                 String       @id @default(uuid()) @db.Uuid
  code               Int          @unique @default(autoincrement())
  name               String?
  birthDate          DateTime?    @map("birth_date") @db.Date
  birthDateEstimated Boolean      @default(false) @map("birth_date_estimated")
  origin             AnimalOrigin @default(UNDEFINED)
  sex                Sex          @default(MALE)
  status             AnimalStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  breedId String? @map("breed_id") @db.Uuid
  breed   Breed?  @relation(fields: [breedId], references: [id], onDelete: Restrict)

  // damId       String?  @db.Uuid @map("dam_id") //Matriz (mãe)
  // dam         Animal?  @relation("AnimalDam", fields: [damId], references: [id], onDelete: Restrict)
  // damProgeny  Animal[] @relation("AnimalDam")

  // sireId       String?  @db.Uuid @map("sire_id") //Reprodutor (pai)
  // sire         Animal?  @relation("AnimalSire", fields: [sireId], references: [id], onDelete: Restrict)
  // sireProgeny  Animal[] @relation("AnimalSire")

  // desnormalizado/sincronizado para lote
  currentBatchId String? @map("current_batch_id") @db.Uuid
  currentBatch   Batch?  @relation(fields: [currentBatchId], references: [id], onDelete: Restrict)

  // desnormalizado/sincronizado para propriedade
  currentPropertyId String   @map("current_property_id") @db.Uuid // Campo desnormalizado, pois há constraints que dependem dele, os históricos são apenas registros
  currentProperty   Property @relation(fields: [currentPropertyId], references: [id], onDelete: Restrict)

  // desnormalizado/sincronizado
  currentTag    String?  @map("current_tag") // Campo desnormalizado, pois há constraints que dependem dele, os históricos são apenas registros
  currentRfid   String?  @map("current_rfid") // Campo desnormalizado, pois há constraints que dependem dele, os históricos são apenas registros
  currentWeight Decimal? @map("current_weight") @db.Decimal(10, 2) // peso atual (kg)
  neutered      Boolean  @default(false) // Indica se está castrado ou não

  // Manejos
  animalNeuterings       AnimalNeutering[]
  animalWeighings        AnimalWeighing[]
  animalTaggings         AnimalTagging[]
  animalRfidTaggings     AnimalRfidTagging[]
  animalBrandings        AnimalBranding[]
  healthManagementItems  HealthManagementItem[]
  managementParticipants ManagementParticipant[]

  // Transferências e históricos
  propertyTransferItems   AnimalPropertyTransferItem[]
  batchTransferItems      AnimalBatchTransferItem[]
  animalPropertyHistories AnimalPropertyHistory[]
  animalBatchHistories    AnimalBatchHistory[]

  // Compras
  purchasedAnimals PurchasedAnimal[]

  @@unique([currentPropertyId, currentTag], where: { status: "ACTIVE", currentTag: { not: null } })
  @@unique([currentPropertyId, currentRfid], where: { status: "ACTIVE", currentRfid: { not: null } })
  @@index([status])
  @@index([breedId])
  //@@index([damId])
  //@@index([sireId])
  @@index([currentPropertyId])
  @@map("animal")
}

model UserSettings {
  userId String @id @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  currentPropertyId String?   @map("current_property_id") @db.Uuid
  currentProperty   Property? @relation(fields: [currentPropertyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([currentPropertyId])
  @@map("user_settings")
}

model Person {
  id                String     @id @default(uuid()) @db.Uuid
  type              PersonType
  taxId             String     @unique @map("tax_id") // CPF/CNPJ
  name              String
  stateRegistration String?    @unique @map("state_registration") // Inscrição Estadual
  phone             String?
  email             String?    @unique
  deactivatedAt     DateTime?  @map("deactivated_at")

  // Exclusivo de Pessoa Jurídica
  tradeName String? @map("trade_name") // Nome Fantasia

  // Exclusivos de Pessoa Física
  rg            String?        @unique // RG (Registro Geral)
  birthDate     DateTime?      @map("birth_date") @db.Date // Data de nascimento
  maritalStatus MaritalStatus? @map("marital_status") // Estado civil

  addressId Int?     @unique @map("address_id")
  address   Address? @relation(fields: [addressId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  properties        Property[]
  healthManagements HealthManagement[]
  purchaseEvents    PurchaseEvent[]

  @@index([type])
  @@index([name])
  @@map("person")
}

model Address {
  id           Int     @id @default(autoincrement())
  zipCode      String  @map("zip_code") // CEP
  street       String // Logradouro
  number       String?
  complement   String? // Complemento
  neighborhood String? // Bairro
  city         String // Município
  state        String // UF (unidade federativa)
  country      String  @default("Brasil") // País

  person   Person?
  property Property?

  @@map("address")
}

model Breed {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @unique
  deactivatedAt DateTime? @map("deactivated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  animals            Animal[]
  purchaseCategories PurchaseCategory[]

  @@map("breed")
}

model ManagementSession {
  id             String    @id @default(uuid()) @db.Uuid
  title          String // identifica a sessão na listagem (ex.: "Pesagem mensal da recria")
  notes          String?
  scheduledDate  DateTime  @map("scheduled_date") // data prevista, usada para lembretes/agendamento
  managementDate DateTime? @map("management_date") // data em que o manejo de fato ocorreu
  confirmedAt    DateTime? @map("confirmed_at")
  cancelledAt    DateTime? @map("cancelled_at")

  // Etapas do manejo, na ordem em que são registradas em cada animal. Cada item é
  // { type: "weighing" | "neutering" | "tag" | "rfid" | "health" | "batch", ... };
  // o sanitário aponta para o HealthManagement (healthManagementId). A configuração dos demais
  // fica no contêiner do tipo (ex.: técnica prevista, lotes sugeridos). A apartação, quando
  // existe, é sempre a última.
  steps Json @default("[]")

  propertyId String   @map("property_id") @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  participants ManagementParticipant[]

  weighingManagement  WeighingManagement?
  neuteringManagement NeuteringManagement?
  tagManagement       TagManagement?
  rfidManagement      RfidManagement?
  brandManagement     BrandManagement?
  batchManagement     BatchManagement?
  healthManagements   HealthManagement[]

  // A sessão de manejo é genérica; quando é usada para receber animais comprados, a
  // compra a incorpora por PurchaseReception (a dependência vai da compra para a sessão).
  purchaseReception PurchaseReception?

  animalBatchTransfers    AnimalBatchTransfer[]
  animalPropertyTransfers AnimalPropertyTransfer[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([propertyId, scheduledDate])
  // Sessões abertas são sempre poucas: a checagem de compromissos dos animais parte
  // delas, sem passar pelo histórico (docs/data-dictionary.md, 2.9).
  @@index([propertyId], map: "management_session_open_idx", where: { confirmedAt: null, cancelledAt: null })
  @@map("management_session")
}

model ManagementParticipant {
  id Int @id @default(autoincrement())

  managementSessionId String            @map("management_session_id") @db.Uuid
  managementSession   ManagementSession @relation(fields: [managementSessionId], references: [id], onDelete: Restrict)

  animalId String @map("animal_id") @db.Uuid
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  // batchId String? @db.Uuid @map("batch_id") // Colocar isso se for frequente precisar de "todas as pesagens realizadas enquanto o animal estava no Lote X"

  // Na apartação, "permanecer no lote atual" não gera transferência; fica registrado aqui
  // para a etapa contar como feita.
  batchKept Boolean @default(false) @map("batch_kept")

  // Último registro de etapa feito no animal (ordena a lista de manejados).
  lastHandledAt DateTime? @map("last_handled_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([managementSessionId, animalId])
  @@index([animalId])
  @@map("management_participant")
}

model TagManagement {
  id    String          @id @default(uuid()) @db.Uuid
  items AnimalTagging[]

  managementSessionId String            @unique @map("management_session_id") @db.Uuid
  managementSession   ManagementSession @relation(fields: [managementSessionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("tag_management")
}

model AnimalTagging {
  id    Int     @id @default(autoincrement())
  tag   String? // null = tag removida
  notes String?

  identifiedAt DateTime @map("identified_at") // data do manejo; em sessão, copiada da data da sessão

  // Correções preservam o rastro: o valor lançado originalmente é guardado na primeira
  // correção e a exclusão é lógica (cancelada = ignorada no histórico e nos cálculos).
  originalTag String?   @map("original_tag")
  correctedAt DateTime? @map("corrected_at")
  cancelledAt DateTime? @map("cancelled_at")

  managementId String?        @map("management_id") @db.Uuid // null = avulso
  management   TagManagement? @relation(fields: [managementId], references: [id], onDelete: Restrict)

  animalId String @map("animal_id") @db.Uuid
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([animalId])
  @@index([managementId])
  @@map("animal_tagging")
}

model RfidManagement {
  id    String              @id @default(uuid()) @db.Uuid
  items AnimalRfidTagging[]

  managementSessionId String            @unique @map("management_session_id") @db.Uuid
  managementSession   ManagementSession @relation(fields: [managementSessionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("rfid_management")
}

model AnimalRfidTagging {
  id    Int     @id @default(autoincrement())
  rfid  String? // null = rfid removido
  notes String?

  identifiedAt DateTime @map("identified_at") // data do manejo; em sessão, copiada da data da sessão

  originalRfid String?   @map("original_rfid")
  correctedAt  DateTime? @map("corrected_at")
  cancelledAt  DateTime? @map("cancelled_at")

  managementId String?         @map("management_id") @db.Uuid // null = avulso
  management   RfidManagement? @relation(fields: [managementId], references: [id], onDelete: Restrict)

  animalId String @map("animal_id") @db.Uuid
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([animalId])
  @@index([managementId])
  @@map("animal_rfid_tagging")
}

model NeuteringManagement {
  id    String            @id @default(uuid()) @db.Uuid
  items AnimalNeutering[]

  // técnica prevista no planejamento: vem pré-selecionada no registro de cada animal,
  // que pode escolher outra; null = não informada
  suggestedTechniqueId String?             @map("suggested_technique_id") @db.Uuid
  suggestedTechnique   NeuteringTechnique? @relation("NeuteringSuggestedTechnique", fields: [suggestedTechniqueId], references: [id], onDelete: Restrict)

  managementSessionId String            @unique @map("management_session_id") @db.Uuid
  managementSession   ManagementSession @relation(fields: [managementSessionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("neutering_management")
}

model AnimalNeutering {
  id    Int     @id @default(autoincrement())
  notes String? // observação específica desse animal (ex.: complicação, sangramento, recastração)

  // técnica usada neste animal (ex.: burdizzo, cirúrgica, elástico); null = não informada
  techniqueId String?             @map("technique_id") @db.Uuid
  technique   NeuteringTechnique? @relation("NeuteringTechnique", fields: [techniqueId], references: [id], onDelete: Restrict)

  neuteredAt DateTime @map("neutered_at") // data do manejo; em sessão, copiada da data da sessão

  // Correções preservam o rastro: os valores lançados originalmente são guardados na primeira
  // correção e a exclusão é lógica (cancelada = ignorada no histórico e nos cálculos).
  originalNeuteredAt  DateTime?           @map("original_neutered_at")
  originalTechniqueId String?             @map("original_technique_id") @db.Uuid
  originalTechnique   NeuteringTechnique? @relation("NeuteringOriginalTechnique", fields: [originalTechniqueId], references: [id], onDelete: Restrict)
  correctedAt         DateTime?           @map("corrected_at")
  cancelledAt         DateTime?           @map("cancelled_at")

  managementId String?              @map("management_id") @db.Uuid // null = avulso
  management   NeuteringManagement? @relation(fields: [managementId], references: [id], onDelete: Restrict)

  animalId String @map("animal_id") @db.Uuid
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([animalId])
  @@index([managementId])
  @@map("animal_neutering")
}

model NeuteringTechnique {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @unique
  deactivatedAt DateTime? @map("deactivated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  neuterings         AnimalNeutering[]     @relation("NeuteringTechnique")
  originalNeuterings AnimalNeutering[]     @relation("NeuteringOriginalTechnique")
  suggestedIn        NeuteringManagement[] @relation("NeuteringSuggestedTechnique")

  @@map("neutering_technique")
}

model WeighingManagement {
  id    String           @id @default(uuid()) @db.Uuid
  items AnimalWeighing[]

  managementSessionId String            @unique @map("management_session_id") @db.Uuid
  managementSession   ManagementSession @relation(fields: [managementSessionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("weighing_management")
}

model AnimalWeighing {
  id        Int      @id @default(autoincrement())
  weight    Decimal  @db.Decimal(10, 2) // valor da pesagem (kg), sempre individual
  notes     String?
  weighedAt DateTime @map("weighed_at") // data do manejo; em sessão, copiada da data da sessão

  // Correções preservam o rastro: o peso lançado originalmente é guardado na primeira correção
  // e a exclusão é lógica (cancelada = ignorada no histórico, gráficos e peso atual).
  originalWeight Decimal?  @map("original_weight") @db.Decimal(10, 2)
  correctedAt    DateTime? @map("corrected_at")
  cancelledAt    DateTime? @map("cancelled_at")

  managementId String?             @map("management_id") @db.Uuid // null = avulso
  management   WeighingManagement? @relation(fields: [managementId], references: [id], onDelete: Restrict)

  animalId String @map("animal_id") @db.Uuid
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([animalId])
  @@index([managementId])
  @@map("animal_weighing")
}

model BrandManagement {
  id    String           @id @default(uuid()) @db.Uuid
  items AnimalBranding[]

  managementSessionId String            @unique @map("management_session_id") @db.Uuid
  managementSession   ManagementSession @relation(fields: [managementSessionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("brand_management")
}

model BatchManagement {
  id               String                      @id @default(uuid()) @db.Uuid
  suggestedBatches BatchManagementSuggestion[]

  managementSessionId String            @unique @map("management_session_id") @db.Uuid
  managementSession   ManagementSession @relation(fields: [managementSessionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("batch_management")
}

model BatchManagementSuggestion {
  managementId String          @map("management_id") @db.Uuid
  management   BatchManagement @relation(fields: [managementId], references: [id], onDelete: Cascade)

  batchId String @map("batch_id") @db.Uuid
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Restrict)

  position Int // ordem em que os lotes aparecem no registro

  @@id([managementId, batchId])
  @@index([batchId])
  @@map("batch_management_suggestion")
}

model AnimalBranding {
  id             Int     @id @default(autoincrement())
  isCounterBrand Boolean @default(false) @map("is_counter_brand") // contramarca (segunda marca, após mudança de dono)
  notes          String?

  brandedAt DateTime @map("branded_at") // data do manejo; em sessão, copiada da data da sessão

  cancelledAt DateTime? @map("cancelled_at")

  managementId String?          @map("management_id") @db.Uuid // null = avulso
  management   BrandManagement? @relation(fields: [managementId], references: [id], onDelete: Restrict)

  animalId String @map("animal_id") @db.Uuid
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([animalId])
  @@index([managementId])
  @@map("animal_branding")
}

model HealthManagement {
  id              String                   @id @default(uuid()) @db.Uuid
  title           String?
  withdrawalUntil DateTime?                @map("withdrawal_until") @db.Date
  nextDueDate     DateTime?                @map("next_due_date") @db.Date
  doseType        HealthManagementDoseType @default(NONE) @map("dose_type")
  doseMl          Decimal?                 @map("dose_ml") @db.Decimal(10, 2) // FIXED: ml por animal; PER_WEIGHT: ml a cada doseWeightKg
  doseWeightKg    Decimal?                 @map("dose_weight_kg") @db.Decimal(10, 2) // PER_WEIGHT: peso de referência (ex.: 1 ml a cada 50 kg)

  performedAt DateTime @map("performed_at") // data do procedimento; em sessão, copiada da data da sessão

  items HealthManagementItem[]

  typeId String               @map("type_id") @db.Uuid
  type   HealthManagementType @relation(fields: [typeId], references: [id], onDelete: Restrict)

  managementSessionId String?            @map("management_session_id") @db.Uuid // null = avulso; sem @unique — múltiplos procedimentos sanitários podem existir na mesma sessão
  managementSession   ManagementSession? @relation(fields: [managementSessionId], references: [id], onDelete: Restrict)

  veterinarianId String? @map("veterinarian_id") @db.Uuid
  veterinarian   Person? @relation(fields: [veterinarianId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([managementSessionId])
  @@index([nextDueDate])
  @@map("health_management")
}

model HealthManagementItem {
  id     Int      @id @default(autoincrement())
  notes  String? // observação específica desse animal nesse procedimento (reação adversa, etc.)
  doseMl Decimal? @map("dose_ml") @db.Decimal(10, 2) // dose aplicada neste animal (ml)

  managementId String           @map("management_id") @db.Uuid
  management   HealthManagement @relation(fields: [managementId], references: [id], onDelete: Restrict)

  animalId String @map("animal_id") @db.Uuid
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([animalId])
  @@index([managementId])
  @@map("health_management_item")
}

model HealthManagementType {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @unique
  deactivatedAt DateTime? @map("deactivated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  managements HealthManagement[]

  @@map("health_management_type")
}

enum HealthManagementDoseType {
  NONE // procedimento sem dose (exame, banho, curativo)
  FIXED // mesma dose para todos os animais
  PER_WEIGHT // dose proporcional ao peso vivo

  @@map("health_management_dose_type")
}

model AnimalPropertyTransfer {
  id           String   @id @default(uuid()) @db.Uuid
  transferDate DateTime @map("transfer_date")
  notes        String?
  gtaNumber    String?  @map("gta_number")

  confirmedAt DateTime? @map("confirmed_at") // origem confirma o envio
  receivedAt  DateTime? @map("received_at") // destino confirma o recebimento
  cancelledAt DateTime? @map("cancelled_at")

  items AnimalPropertyTransferItem[]

  originPropertyId String   @map("origin_property_id") @db.Uuid
  originProperty   Property @relation("AnimalPropertyTransferOrigin", fields: [originPropertyId], references: [id], onDelete: Restrict)

  destinationPropertyId String   @map("destination_property_id") @db.Uuid
  destinationProperty   Property @relation("AnimalPropertyTransferDestination", fields: [destinationPropertyId], references: [id], onDelete: Restrict)

  originBatchId String? @map("origin_batch_id") @db.Uuid // null = animais vinham sem lote
  originBatch   Batch?  @relation("AnimalPropertyTransferOriginBatch", fields: [originBatchId], references: [id], onDelete: Restrict)

  destinationBatchId String? @map("destination_batch_id") @db.Uuid // preenchido só no recebimento, pelo destino
  destinationBatch   Batch?  @relation("AnimalPropertyTransferDestinationBatch", fields: [destinationBatchId], references: [id], onDelete: Restrict)

  managementSessionId String?            @map("management_session_id") @db.Uuid // null = transferência isolada
  managementSession   ManagementSession? @relation(fields: [managementSessionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([originPropertyId])
  @@index([destinationPropertyId])
  @@index([originBatchId])
  @@index([destinationBatchId])
  @@map("animal_property_transfer")
}

model AnimalPropertyTransferItem {
  id    Int     @id @default(autoincrement())
  notes String?

  transferId String                 @map("transfer_id") @db.Uuid
  transfer   AnimalPropertyTransfer @relation(fields: [transferId], references: [id], onDelete: Restrict)

  animalId String @map("animal_id") @db.Uuid
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([animalId])
  @@index([transferId])
  @@map("animal_property_transfer_item")
}

model AnimalPropertyHistory {
  id        Int       @id @default(autoincrement())
  enteredAt DateTime  @map("entered_at")
  exitedAt  DateTime? @map("exited_at")
  notes     String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  animalId String @map("animal_id") @db.Uuid
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  propertyId String   @map("property_id") @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  @@unique([animalId], where: { exitedAt: null })
  @@index([animalId, enteredAt])
  @@index([propertyId], where: { exitedAt: null })
  @@map("animal_property_history")
}

model AnimalBatchTransfer {
  id           String    @id @default(uuid()) @db.Uuid
  transferDate DateTime  @map("transfer_date")
  notes        String?
  confirmedAt  DateTime? @map("confirmed_at")
  cancelledAt  DateTime? @map("cancelled_at")

  items AnimalBatchTransferItem[]

  destinationBatchId String @map("destination_batch_id") @db.Uuid
  destinationBatch   Batch  @relation("AnimalBatchTransferDestination", fields: [destinationBatchId], references: [id], onDelete: Restrict)

  propertyId String   @map("property_id") @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  managementSessionId String?            @map("management_session_id") @db.Uuid // null = transferência isolada
  managementSession   ManagementSession? @relation(fields: [managementSessionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([destinationBatchId])
  @@index([propertyId])
  @@index([managementSessionId])
  // Idem para as transferências pendentes.
  @@index([propertyId], map: "animal_batch_transfer_open_idx", where: { confirmedAt: null, cancelledAt: null })
  @@map("animal_batch_transfer")
}

model AnimalBatchTransferItem {
  id    Int     @id @default(autoincrement())
  notes String?

  transferId String              @map("transfer_id") @db.Uuid
  transfer   AnimalBatchTransfer @relation(fields: [transferId], references: [id], onDelete: Restrict)

  animalId String @map("animal_id") @db.Uuid
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  // Lote do animal no momento da confirmação (null enquanto pendente ou se o animal estava sem lote)
  originBatchId String? @map("origin_batch_id") @db.Uuid
  originBatch   Batch?  @relation("AnimalBatchTransferItemOrigin", fields: [originBatchId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([animalId])
  @@index([transferId])
  @@index([originBatchId])
  @@map("animal_batch_transfer_item")
}

model AnimalBatchHistory {
  id        Int       @id @default(autoincrement())
  enteredAt DateTime  @map("entered_at")
  exitedAt  DateTime? @map("exited_at")
  notes     String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  animalId String @map("animal_id") @db.Uuid
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  batchId String? @map("batch_id") @db.Uuid // null = animal sem lote nesse período
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@unique([animalId], where: { exitedAt: null })
  @@index([animalId, enteredAt])
  @@index([batchId], where: { exitedAt: null })
  @@map("animal_batch_history")
}

model PurchaseEvent {
  id           String   @id @default(uuid()) @db.Uuid
  title        String // distingue compras do mesmo vendedor
  purchaseDate DateTime @map("purchase_date")
  notes        String?

  // Situação: em andamento (sem confirmedAt/cancelledAt), consolidada ou cancelada.
  // O pagamento é um fato registrado durante o andamento; bloqueia os valores.
  paidAt           DateTime? @map("paid_at")
  paymentReference String?   @map("payment_reference") // comprovante (PIX, TED...)
  confirmedAt      DateTime? @map("confirmed_at") // consolidada: custos rateados, nada mais muda
  cancelledAt      DateTime? @map("cancelled_at")

  sellerId              String   @map("seller_id") @db.Uuid
  seller                Person   @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  destinationPropertyId String   @map("destination_property_id") @db.Uuid
  destinationProperty   Property @relation(fields: [destinationPropertyId], references: [id], onDelete: Restrict)

  categories       PurchaseCategory[]
  receptions       PurchaseReception[] // uma compra pode ter várias recepções (viagens)
  purchasedAnimals PurchasedAnimal[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sellerId])
  @@index([destinationPropertyId])
  @@map("purchase_event")
}

model PurchaseCategory {
  id               Int     @id @default(autoincrement())
  sex              Sex
  minAgeMonths     Int?    @map("min_age_months")
  maxAgeMonths     Int?    @map("max_age_months")
  expectedQuantity Int     @map("expected_quantity")
  notes            String?

  pricingType    PurchasePricingType @map("pricing_type")
  unitPrice      Decimal?            @map("unit_price") @db.Decimal(12, 2) // por cabeça ou por arroba
  totalPrice     Decimal?            @map("total_price") @db.Decimal(12, 2) // LUMP_SUM
  invoicedWeight Decimal?            @map("invoiced_weight") @db.Decimal(12, 2) // peso de origem/embarque (kg), base do pagamento
  shrinkPercent  Decimal?            @map("shrink_percent") @db.Decimal(5, 2) // quebra acordada
  costSplit      PurchaseCostSplit   @default(EQUAL) @map("cost_split") // rateio do valor fechado

  breedId String? @map("breed_id") @db.Uuid
  breed   Breed?  @relation(fields: [breedId], references: [id], onDelete: Restrict)

  eventId String        @map("event_id") @db.Uuid
  event   PurchaseEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  animals PurchasedAnimal[]

  @@unique([id, eventId]) // alvo da FK composta de PurchasedAnimal (mesma compra)
  @@index([eventId])
  @@map("purchase_category")
}

// Chegada física de animais de uma compra (uma por viagem). A compra incorpora uma
// sessão de manejo para receber os animais: os animais são criados no registro da
// sessão e recebem nela os primeiros manejos.
model PurchaseReception {
  id String @id @default(uuid()) @db.Uuid

  purchaseEventId String        @map("purchase_event_id") @db.Uuid
  purchaseEvent   PurchaseEvent @relation(fields: [purchaseEventId], references: [id], onDelete: Restrict)

  managementSessionId String            @unique @map("management_session_id") @db.Uuid
  managementSession   ManagementSession @relation(fields: [managementSessionId], references: [id], onDelete: Restrict)

  // Lote em que os animais recebidos entram (até uma eventual apartação).
  entryBatchId String @map("entry_batch_id") @db.Uuid
  entryBatch   Batch  @relation(fields: [entryBatchId], references: [id], onDelete: Restrict)

  // Documentos da carga (cada viagem tem os seus).
  gtaNumber     String? @map("gta_number")
  invoiceNumber String? @map("invoice_number")

  purchasedAnimals PurchasedAnimal[]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([id, purchaseEventId]) // alvo da FK composta de PurchasedAnimal (mesma compra)
  @@index([purchaseEventId])
  @@index([entryBatchId])
  @@map("purchase_reception")
}

// Vínculo animal ↔ compra, criado na recepção. Categoria e recepção são ligadas por FKs
// compostas com purchase_event_id: o banco garante que as duas são da mesma compra.
model PurchasedAnimal {
  id   Int      @id @default(autoincrement())
  // Custo de aquisição, rateado uma única vez na consolidação da compra (nulo antes).
  cost Decimal? @db.Decimal(12, 2)

  purchaseEventId String        @map("purchase_event_id") @db.Uuid
  purchaseEvent   PurchaseEvent @relation(fields: [purchaseEventId], references: [id], onDelete: Restrict)

  categoryId Int              @map("category_id")
  category   PurchaseCategory @relation(fields: [categoryId, purchaseEventId], references: [id, eventId], onDelete: Restrict)

  receptionId String            @map("reception_id") @db.Uuid
  reception   PurchaseReception @relation(fields: [receptionId, purchaseEventId], references: [id, purchaseEventId], onDelete: Restrict)

  animalId String @unique @map("animal_id") @db.Uuid
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([purchaseEventId])
  @@index([categoryId])
  @@index([receptionId])
  @@map("purchased_animal")
}

// Enums

enum PurchasePricingType {
  PER_HEAD
  PER_ARROBA
  LUMP_SUM

  @@map("purchase_pricing_type")
}

// Rateio do valor fechado entre os animais recebidos.
enum PurchaseCostSplit {
  EQUAL // valor ÷ recebidos
  BY_WEIGHT // proporcional ao peso de entrada

  @@map("purchase_cost_split")
}

enum Sex {
  MALE // Macho
  FEMALE // Fêmea

  @@map("sex")
}

enum AnimalOrigin {
  UNDEFINED // Indefinida
  BIRTH // Nascimento
  PURCHASE // Compra
  DONATION // Doação
  REFERENCE // Referência (o animal não existe na fazenda, serve apenas de referência para genealogia)

  @@map("animal_origin")
}

enum AnimalStatus {
  ACTIVE // Ativo na propriedade
  SOLD // Vendido
  DONATED // Doado
  DEAD // Morto
  DISCARDED // Descarte
  SLAUGHTERED // Abate
  REFERENCE // Referência (o animal não existe na fazenda, serve apenas de referência para genealogia)

  @@map("animal_status")
}

enum PersonType {
  INDIVIDUAL // Pessoa Física
  COMPANY // Pessoa Jurídica

  @@map("person_type")
}

enum MaritalStatus {
  SINGLE // Solteiro
  MARRIED // Casado
  STABLE_UNION // União Estável
  DIVORCED // Divorciado
  WIDOWED // Viúvo

  @@map("marital_status")
}

// Models do Better Auth (autenticação de usuários do sistema)

model User {
  id            String  @id
  name          String
  email         String  @unique
  emailVerified Boolean @default(false) @map("email_verified")
  image         String?

  // Campos do plugin "admin" do better-auth
  role       String?
  banned     Boolean?  @default(false)
  banReason  String?   @map("ban_reason")
  banExpires DateTime? @map("ban_expires")

  sessions Session[]
  accounts Account[]
  settings UserSettings?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")

  // Campo do plugin "admin" do better-auth (sessão de impersonation)
  impersonatedBy String? @map("impersonated_by")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("session")
}

model Account {
  id           String  @id
  accountId    String  @map("account_id")
  providerId   String  @map("provider_id")
  accessToken  String? @map("access_token")
  refreshToken String? @map("refresh_token")
  idToken      String? @map("id_token")
  scope        String?
  password     String?

  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("verification")
}
