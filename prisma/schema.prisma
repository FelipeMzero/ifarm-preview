// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema


generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User { 
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String?
  posts Post[]
} 

model Post { 
  id        Int     @id @default(autoincrement()) 
  title     String
  content   String?
  published Boolean @default(false) 
  author    User    @relation(fields: [authorId], references: [id]) 
  authorId  Int
} 

model PerformanceTest {
  id            Int       @id
  description   String
  date          DateTime
}

enum Sexo {
  M
  F
}

enum AnimalOrigem {
  NASCIMENTO
  COMPRA
  TRANSFERENCIA
}

enum AnimalStatus {
  ATIVO
  VENDIDO
  MORTO
  TRANSFERIDO
  DESCARTE
  ABATE
}

model Raca {
  id      Int      @id @default(autoincrement())
  nome    String   @unique
  animais Animal[]
}

model Lote {
  id      Int      @id @default(autoincrement())
  nome    String   @unique
  animais Animal[]
}

model Fazenda {
  id            Int      @id @default(autoincrement())
  nome          String   @unique
  animaisOrigem Animal[] @relation("FazendaOrigem")
}

model Animal {
  id                 String       @id @default(uuid())
  brinco             String       @unique
  rfid               String?      @unique
  nome_apelido       String?
  sexo               Sexo
  data_nascimento    DateTime?
  peso_nascimento_kg Float?
  origem             AnimalOrigem @default(NASCIMENTO)
  status             AnimalStatus @default(ATIVO)
  
  raca_id Int?
  raca    Raca? @relation(fields: [raca_id], references: [id])
  
  lote_id Int?
  lote    Lote? @relation(fields: [lote_id], references: [id])
  
  mae_id String?
  mae    Animal? @relation("AnimalMae", fields: [mae_id], references: [id])
  filhosMae Animal[] @relation("AnimalMae")

  pai_id String?
  pai    Animal? @relation("AnimalPai", fields: [pai_id], references: [id])
  filhosPai Animal[] @relation("AnimalPai")

  fazenda_origem_id Int?
  fazenda_origem    Fazenda? @relation("FazendaOrigem", fields: [fazenda_origem_id], references: [id])
  
  fazenda_origem_nome String? // Nome quando não está cadastrado como entidade local
  
  data_aquisicao      DateTime?
  valor_compra        Float?
  idade_entrada_meses Int?
  
  peso_atual_kg Float? // Guardando para simplificar consulta conforme frontend
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}