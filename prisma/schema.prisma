// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema


generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum Sex {
  MALE   // Macho
  FEMALE // Fêmea

  @@map("sex")
}

enum AnimalOrigin {
  BIRTH    // Nascimento
  PURCHASE // Compra
  TRANSFER // Transferência

  @@map("animal_origin")
}

enum AnimalStatus {
  ACTIVE      // Ativo
  SOLD        // Vendido
  DEAD        // Morto
  TRANSFERRED // Transferido
  DISCARDED   // Descarte
  SLAUGHTERED // Abate

  @@map("animal_status")
}

enum PersonType {
  INDIVIDUAL // Pessoa Física
  COMPANY    // Pessoa Jurídica

  @@map("person_type")
}

enum MaritalStatus {
  SINGLE       // Solteiro
  MARRIED      // Casado
  STABLE_UNION // União Estável
  DIVORCED     // Divorciado
  WIDOWED      // Viúvo

  @@map("marital_status")
}

model Address {
  id          Int     @id @default(autoincrement())
  zipCode     String  @map("zip_code")     // CEP
  street      String                        // Logradouro
  number      String?
  complement  String?                       // Complemento
  neighborhood String?                      // Bairro
  city        String                        // Município
  state       String                        // UF (unidade federativa)
  country     String  @default("Brasil")    // País

  person Person?

  @@map("address")
}

model Person {
  id             String     @id @default(uuid())
  type           PersonType
  taxId          String     @unique @map("tax_id") // CPF/CNPJ
  name           String
  stateRegistration String? @unique @map("state_registration") // Inscrição Estadual
  phone          String?
  email          String?    @unique

  addressId Int?     @unique @map("address_id")
  address   Address? @relation(fields: [addressId], references: [id])

  // Exclusivo de Pessoa Jurídica
  tradeName String? @map("trade_name") // Nome Fantasia

  // Exclusivos de Pessoa Física
  rg            String?        @unique          // RG (Registro Geral)
  birthDate     DateTime?      @db.Date @map("birth_date")
  maritalStatus MaritalStatus? @map("marital_status")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  deactivatedAt DateTime? @map("deactivated_at")

  @@index([type])
  @@index([name])
  @@map("person")
}



model Breed {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  animals Animal[]

  @@map("breed")
}

model Batch {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  animals Animal[]

  @@map("batch")
}

model Farm {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  originAnimals Animal[] @relation("FarmOrigin")

  @@map("farm")
}

model Animal {
  id             String       @id @default(uuid())
  earTag         String       @unique @map("ear_tag") // Brinco (identificação do animal)
  rfid           String?      @unique
  name           String?
  birthDate      DateTime?    @db.Date @map("birth_date")
  birthWeightKg  Float?       @map("birth_weight_kg")
  sex            Sex          @default(MALE)
  origin         AnimalOrigin @default(BIRTH)
  status         AnimalStatus @default(ACTIVE)

  breedId Int?   @map("breed_id")
  breed   Breed? @relation(fields: [breedId], references: [id])

  batchId Int?   @map("batch_id")
  batch   Batch? @relation(fields: [batchId], references: [id])

  motherId       String?  @map("mother_id")
  mother         Animal?  @relation("AnimalMother", fields: [motherId], references: [id])
  motherChildren Animal[] @relation("AnimalMother")

  fatherId       String?  @map("father_id")
  father         Animal?  @relation("AnimalFather", fields: [fatherId], references: [id])
  fatherChildren Animal[] @relation("AnimalFather")

  originFarmId   Int?     @map("origin_farm_id")
  originFarm     Farm?    @relation("FarmOrigin", fields: [originFarmId], references: [id])
  originFarmName String?  @map("origin_farm_name") // usado quando a fazenda não está cadastrada localmente

  acquisitionDate   DateTime? @db.Date @map("acquisition_date")
  purchasePrice     Decimal?  @db.Decimal(10, 2) @map("purchase_price")
  entryAgeMonths    Int?      @map("entry_age_months")

  currentWeightKg Float? @map("current_weight_kg") // denormalizado para simplificar consulta no frontend

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([batchId])
  @@index([breedId])
  @@index([status])
  @@map("animal")
}


// Models do Better Auth (autenticação de usuários do sistema)

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?

  // Campos do plugin "admin" do better-auth
  role       String?
  banned     Boolean?  @default(false)
  banReason  String?   @map("ban_reason")
  banExpires DateTime? @map("ban_expires")

  sessions Session[]
  accounts Account[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")

  // Campo do plugin "admin" do better-auth (sessão de impersonation)
  impersonatedBy String? @map("impersonated_by")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("session")
}

model Account {
  id           String  @id
  accountId    String  @map("account_id")
  providerId   String  @map("provider_id")
  accessToken  String? @map("access_token")
  refreshToken String? @map("refresh_token")
  idToken      String? @map("id_token")
  scope        String?
  password     String?

  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("verification")
}
