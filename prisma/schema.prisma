// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema


generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum Sexo {
  MACHO
  FEMEA
}

enum AnimalOrigem {
  NASCIMENTO
  COMPRA
  TRANSFERENCIA
}

enum AnimalStatus {
  ATIVO
  VENDIDO
  MORTO
  TRANSFERIDO
  DESCARTE
  ABATE
}

enum PessoaTipo {
  FISICA
  JURIDICA
}

enum EstadoCivil {
  SOLTEIRO
  CASADO
  UNIAO_ESTAVEL
  DIVORCIADO
  VIUVO
}

model Endereco {
  id          Int     @id @default(autoincrement())
  cep         String
  logradouro  String
  numero      String?
  complemento String?
  bairro      String?
  municipio   String
  uf          String
  pais        String  @default("Brasil")

  pessoa Pessoa?

  @@map("endereco")
}

model Pessoa {
  id                String       @id @default(uuid())
  tipo              PessoaTipo
  documento         String       @unique
  nome              String
  inscricaoEstadual String?      @unique @map("inscricao_estadual")
  telefone          String?
  email             String?      @unique

  enderecoId Int?      @unique @map("endereco_id")
  endereco   Endereco? @relation(fields: [enderecoId], references: [id])

  // Exclusivo de Pessoa Jurídica
  nomeFantasia String? @map("nome_fantasia")

  // Exclusivos de Pessoa Física
  rg             String?      @unique
  dataNascimento DateTime?    @db.Date @map("data_nascimento")
  estadoCivil    EstadoCivil? @map("estado_civil")

  criadoEm DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")
  excluidoEm DateTime? @map("excluido_em")
  desativadoEm DateTime? @map("desativado_em")

  @@index([tipo])
  @@index([nome])
  @@map("pessoa")
}













model Raca {
  id      Int      @id @default(autoincrement())
  nome    String   @unique
  animais Animal[]

  @@map("raca")
}

model Lote {
  id      Int      @id @default(autoincrement())
  nome    String   @unique
  animais Animal[]

  @@map("lote")
}

model Fazenda {
  id            Int      @id @default(autoincrement())
  nome          String   @unique
  animaisOrigem Animal[] @relation("FazendaOrigem")

  @@map("fazenda")
}

model Animal {
  id               String       @id @default(uuid())
  brinco           String       @unique
  rfid             String?      @unique
  nome             String?
  dataNascimento   DateTime?    @db.Date @map("data_nascimento")
  pesoNascimentoKg Float?       @map("peso_nascimento_kg")
  sexo             Sexo         @default(MACHO)
  origem           AnimalOrigem @default(NASCIMENTO)
  status           AnimalStatus @default(ATIVO)

  racaId Int?  @map("raca_id")
  raca   Raca? @relation(fields: [racaId], references: [id])

  loteId Int?  @map("lote_id")
  lote   Lote? @relation(fields: [loteId], references: [id])

  maeId     String?  @map("mae_id")
  mae       Animal?  @relation("AnimalMae", fields: [maeId], references: [id])
  filhosMae Animal[] @relation("AnimalMae")

  paiId     String?  @map("pai_id")
  pai       Animal?  @relation("AnimalPai", fields: [paiId], references: [id])
  filhosPai Animal[] @relation("AnimalPai")

  fazendaOrigemId   Int?     @map("fazenda_origem_id")
  fazendaOrigem     Fazenda? @relation("FazendaOrigem", fields: [fazendaOrigemId], references: [id])
  fazendaOrigemNome String?  @map("fazenda_origem_nome") // usado quando a fazenda não está cadastrada localmente

  dataAquisicao     DateTime? @db.Date @map("data_aquisicao")
  valorCompra       Decimal?  @db.Decimal(10, 2) @map("valor_compra")
  idadeEntradaMeses Int?      @map("idade_entrada_meses")

  pesoAtualKg Float? @map("peso_atual_kg") // denormalizado para simplificar consulta no frontend

  criadoEm DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")
  excluidoEm DateTime? @map("excluido_em")

  @@index([loteId])
  @@index([racaId])
  @@index([status])
  @@map("animal")
}

